    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_id",
        "class",
        "steps",
        "scenario_sha256"
      ],
      "properties": {
        "test_id": {
          "$ref": "#/$defs/identity"
        },
        "class": {
          "enum": [
            "positive",
            "boundary",
            "negative",
            "mutation"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/acceptanceStep"
          }
        },
        "scenario_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "acceptanceStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "input_sha256",
        "input",
        "expected",
        "predecessor_step_id_or_null"
      ],
      "properties": {
        "step_id": {
          "$ref": "#/$defs/identity"
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input": {
