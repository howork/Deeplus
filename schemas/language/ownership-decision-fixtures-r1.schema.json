              }
            },
            {
              "$ref": "#/$defs/supplementalStep",
              "properties": {
                "step_id": {
                  "const": "OWN-COVERAGE-REPLACE-INOUT-B-R5/step-01-replace_resource_boundary"
                },
                "coverage_class": {
                  "const": "boundary"
                }
              }
            },
            {
              "$ref": "#/$defs/supplementalStep",
              "properties": {
                "step_id": {
                  "const": "OWN-COVERAGE-REPLACE-INOUT-N-R5/step-01-replace_overlap_rejected"
                },
                "coverage_class": {
                  "const": "negative"
                }
              }
            }
          ],
          "items": false
        }
      }
    },
    "supplementalStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "input_sha256",
        "input",
        "expected",
        "coverage_only",
        "coverage_class",
        "acceptance_test_id_or_null",
        "reason"
      ],
      "properties": {
        "step_id": {
          "$ref": "#/$defs/identity"
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input": {
          "$ref": "ownership-decision-input-r1.schema.json"
        },
        "expected": {
          "$ref": "#/$defs/expected"
        },
        "coverage_only": {
          "const": true
        },
        "coverage_class": {
          "enum": [
            "positive",
            "boundary",
            "negative"
          ]
        },
        "acceptance_test_id_or_null": {
          "type": "null"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "semantic_oracle_key_or_null",
        "primary_diagnostic_id_or_null",
        "internal_reason_or_null",
        "postcondition_facts",
        "evaluator_output_assertion",
        "output_state_assertion",
        "state_assertions",
        "identity_conservation",
        "metamorphic_assertions",
        "canonical_output_state_digest_or_null",
        "simulated_output_state_digest_or_null",
        "next_input_state_binding_or_null"
      ],
      "properties": {
        "result": {
          "enum": [
            "ADMIT",
            "REJECT",
            "INPUT_INVALID"
          ]
        },
        "semantic_oracle_key_or_null": {
          "$ref": "#/$defs/nullableIdentity"
        },
        "primary_diagnostic_id_or_null": {
          "$ref": "#/$defs/nullableIdentity"
        },
        "internal_reason_or_null": {
          "$ref": "#/$defs/nullableIdentity"
        },
        "postcondition_facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evaluator_output_assertion": {
          "$ref": "#/$defs/evaluatorOutputAssertion"
        },
        "output_state_assertion": {
          "$ref": "#/$defs/outputStateAssertion"
        },
        "state_assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stateAssertion"
          }
        },
        "identity_conservation": {
          "$ref": "#/$defs/identityConservation"
        },
        "metamorphic_assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metamorphicAssertion"
          }
        },
        "canonical_output_state_digest_domain": {
          "type": "string",
          "minLength": 1
        },
        "consumed_input_state_representation": {
          "const": "SEMANTIC_OWNERSHIP_STATE_FIELDS_ONLY"
        },
        "consumed_input_state_digest_domain": {
          "type": "string",
          "minLength": 1
        },
        "consumed_input_state_digest": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_output_state_digest_or_null": {
          "$ref": "#/$defs/nullableSha256"
        },
        "simulated_output_state_digest_or_null": {
          "$ref": "#/$defs/nullableSha256"
        },
        "next_input_state_binding_or_null": {
          "$ref": "#/$defs/nullableNextInputStateBinding"
        },
        "machine_delta_complete": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "ADMIT"
              }
            },
            "required": [
              "result"
            ]
          },
          "then": {
            "required": [
              "canonical_output_state_digest_domain",
              "machine_delta_complete"
            ],
            "properties": {
              "canonical_output_state_digest_or_null": {
                "$ref": "#/$defs/sha256"
              },
              "simulated_output_state_digest_or_null": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "else": {
            "required": [
              "consumed_input_state_representation",
              "consumed_input_state_digest_domain",
              "consumed_input_state_digest"
            ],
            "properties": {
              "canonical_output_state_digest_or_null": {
                "type": "null"
              },
              "simulated_output_state_digest_or_null": {
                "type": "null"
              },
              "next_input_state_binding_or_null": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "evaluatorOutputAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant",
        "semantic_oracle_key_or_null",
        "primary_diagnostic_id_or_null",
        "internal_reason_or_null",
        "emitted_primary_count",
        "later_candidate_status"
      ],
      "properties": {
        "variant": {
