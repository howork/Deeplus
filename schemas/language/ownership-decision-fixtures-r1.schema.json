        },
        "predecessor_step_id_or_null": {
          "$ref": "#/$defs/nullableIdentity"
        }
      }
    },
    "supplementalOperationCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptance_identity_effect",
        "exact_additional_step_count",
        "minimum_missing_variant_step_count",
        "required_replace_profile_additional_step_count",
        "minimum_reason",
        "steps"
      ],
      "properties": {
        "acceptance_identity_effect": {
          "const": "NONE"
        },
        "exact_additional_step_count": {
          "const": 6
        },
        "minimum_missing_variant_step_count": {
          "const": 4
        },
        "required_replace_profile_additional_step_count": {
          "const": 2
        },
        "minimum_reason": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
