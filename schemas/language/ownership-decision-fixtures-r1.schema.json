{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplus-lang.org/schema/r51f3/schemas/language/ownership-decision-fixtures-r1.schema.json",
  "title": "OwnershipDecisionFixturesR1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "baseline_commit",
    "execution_status",
    "product_support",
    "fixture_simulator_authority_boundary",
    "semantic_input_schema",
    "authoring_template_reference_count",
    "runtime_patch_or_inheritance_read_count",
    "fixture_metadata_semantic_read_count",
    "operation_access_role_matrix",
    "supplemental_operation_coverage",
    "scenarios",
    "counts",
    "canonicalization"
  ],
  "properties": {
    "schema": {
      "const": "deeplus.ownership-decision-fixtures/r1"
    },
    "repository": {
      "const": "howork/Deeplus"
    },
    "baseline_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "execution_status": {
      "const": "SPECIFIED_NOT_RUN"
    },
    "product_support": {
      "const": "NOT_RUN"
    },
    "fixture_simulator_authority_boundary": {
      "$ref": "#/$defs/simulatorAuthorityBoundary"
    },
    "semantic_input_schema": {
      "const": "deeplus.ownership-decision-input/r1"
    },
    "authoring_template_reference_count": {
      "const": 0
    },
    "runtime_patch_or_inheritance_read_count": {
      "const": 0
    },
    "fixture_metadata_semantic_read_count": {
      "const": 0
    },
    "operation_access_role_matrix": {
      "$ref": "#/$defs/operationAccessRoleMatrix"
    },
    "supplemental_operation_coverage": {
      "$ref": "#/$defs/supplementalOperationCoverage"
    },
    "scenarios": {
      "$ref": "#/$defs/scenarios"
    },
    "counts": {
      "$ref": "#/$defs/exactCounts"
    },
    "canonicalization": {
      "$ref": "#/$defs/canonicalization"
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1
    },
    "nullableIdentity": {
      "oneOf": [
        {
          "$ref": "#/$defs/identity"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "simulatorAuthorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "applies_to",
        "general_r5_semantic_oracle",
        "production_implementation_evidence",
        "product_support_claim"
      ],
      "properties": {
        "classification": {
          "const": "FIXTURE_BOUNDED_NONPRODUCTION"
        },
        "applies_to": {
          "const": "_simulated_admit_output_state and fixture expected-state digest evidence"
        },
        "general_r5_semantic_oracle": {
          "const": false
        },
        "production_implementation_evidence": {
          "const": false
        },
        "product_support_claim": {
          "const": "NOT_RUN"
        }
      }
    },
    "operationAccessRoleMatrix": {
      "const": [
        {
          "operation": "Initialize",
          "roles": [
            {
              "role": "target",
              "place_source": "operation.place_id",
              "mode": "Write",
              "via_loan": null
            }
          ]
        },
        {
          "operation": "Read",
          "roles": [
            {
              "role": "target",
              "place_source": "operation.place_id",
              "mode": "Read",
              "via_loan": "exact Active LoanId iff target is a view; otherwise null"
            }
          ]
        },
        {
          "operation": "Write",
          "roles": [
            {
              "role": "target",
              "place_source": "operation.place_id",
              "mode": "Write",
              "via_loan": "exact Active LoanId iff target is a view; otherwise null"
            }
          ]
        },
        {
          "operation": "ReserveMove",
          "roles": [
            {
              "role": "source",
              "place_source": "operation.place_id",
              "mode": "Move",
              "via_loan": null
            }
          ]
        },
        {
          "operation": "CancelReservation",
          "roles": []
        },
        {
          "operation": "Move",
          "roles": [
            {
              "role": "source",
              "place_source": "operation.source_place_id",
              "mode": "Move",
              "via_loan": null
            },
            {
              "role": "destination",
              "place_source": "operation.destination_place_id",
              "mode": "Write",
              "via_loan": null
            }
          ]
        },
        {
          "operation": "BeginSharedLoan",
          "roles": [
            {
              "role": "owner",
              "place_source": "operation.owner_place_id",
              "mode": "SharedBorrow",
              "via_loan": null
            }
          ]
        },
        {
          "operation": "BeginExclusiveLoan",
          "roles": [
            {
              "role": "owner",
              "place_source": "operation.owner_place_id",
              "mode": "ExclusiveBorrow",
              "via_loan": null
            }
          ]
        },
        {
          "operation": "BeginReborrow",
          "roles": [
            {
              "role": "child_owner",
              "place_source": "operation.child_owner_place_id",
              "mode": "child LoanDef Shared -> SharedBorrow; Exclusive -> ExclusiveBorrow",
              "via_loan": "operation.parent_loan_id, exact Active parent"
            }
          ]
        },
        {
          "operation": "EndLoan",
          "roles": []
        },
        {
          "operation": "ReplaceInout",
          "roles": [
            {
              "role": "caller",
              "place_source": "operation.place_id",
              "mode": "MutAcquire",
              "via_loan": "operation.loan_id, exact Active Exclusive call loan"
            },
            {
              "role": "replacement",
              "place_source": "operation.replacement_place_id",
              "mode": "Move",
              "via_loan": null
            },
            {
              "role": "staging",
              "place_source": "operation.old_value_staging_place_id",
              "mode": "Write",
              "via_loan": null
            }
          ]
        },
        {
          "operation": "Cleanup",
          "roles": [
            {
              "role": "complete_owned_closure",
              "place_source": "full state_rewrite_closure(operation.place_id)",
              "mode": "Cleanup",
              "via_loan": null
            }
          ]
        },
        {
          "operation": "Join",
          "roles": []
        }
      ]
    },
