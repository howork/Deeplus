{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplus.dev/schemas/language/pattern-match-ownership-split-evidence-r1.schema.json",
  "title": "Deeplus R60 Pattern Match Ownership Split Evidence Overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "revision",
    "canonical_baseline_commit",
    "local_predecessor_commit",
    "candidate_status",
    "feature_ids",
    "evidence_entries",
    "bindings",
    "acceptance_cases",
    "counts",
    "guards"
  ],
  "properties": {
    "$schema": {"const": "../../../schemas/language/pattern-match-ownership-split-evidence-r1.schema.json"},
    "schema": {"const": "deeplus.pattern-match-ownership-split-evidence/r1"},
    "revision": {"const": "r60-local-pattern-match-ownership-split-trace-closure-r1"},
    "canonical_baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "local_predecessor_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_status": {"const": "NONCANONICAL_DESIGN_STATIC_EVIDENCE_OVERLAY"},
    "feature_ids": {"const": ["pattern_match_ownership_split"]},
    "evidence_entries": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceEntry"}},
    "bindings": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/binding"}},
    "acceptance_cases": {"type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/traceCase"}},
    "counts": {
      "const": {
        "feature_count": 1,
        "evidence_entry_count": 2,
        "binding_count": 2,
        "acceptance_case_count": 12,
        "acceptance_stage_transition_count": 0,
        "predecessor_blocked_cell_count": 2,
        "overlay_bound_direct_transition_count": 2,
        "overlay_bound_delegated_transition_count": 0,
        "overlay_not_applicable_transition_count": 0,
        "predecessor_cumulative_overlay_binding_count": 113,
        "post_overlay_cumulative_binding_count": 115,
        "predecessor_total_bound_direct_cell_count": 2450,
        "predecessor_total_bound_delegated_cell_count": 3,
        "predecessor_total_not_applicable_cell_count": 502,
        "predecessor_total_blocked_cell_count": 1266,
        "post_overlay_total_bound_direct_cell_count": 2452,
        "post_overlay_total_bound_delegated_cell_count": 3,
        "post_overlay_total_not_applicable_cell_count": 502,
        "post_overlay_total_blocked_cell_count": 1264,
        "post_overlay_missing_cell_count": 0,
        "post_overlay_conflict_cell_count": 0
      }
    },
    "guards": {
      "const": {
        "target_feature_count": 469,
        "target_feature_id_list_sha256": "86414f1c8690515497a5a4c284cfcc22084b0ff2962b8c38b073ac79a6b40435",
        "excluded_feature_count": 254,
        "excluded_feature_id_list_sha256": "8bf7368f5a219fc17fca9d7e5c84adc0b5f8975eb1a590a04ab15ce92b8c10b7",
        "transitioned_cell_count": 2,
        "excluded_reverse_dependent_transition_count": 0,
        "preview_transition_count": 0,
        "other_cell_transition_count": 0,
        "source_activation": "none",
        "surface_change_count": 0,
        "ast_identity_change_count": 0,
        "hir_identity_change_count": 0,
        "mir_operation_kind_change_count": 0,
        "semantic_p0": 0,
        "feature_p1": "22_OPEN_UNCHANGED",
        "m13_actions": "4_OPEN_UNCHANGED",
        "product_lanes": "15_OF_15_NOT_RUN",
        "github_publication": "SUSPENDED",
        "product_execution_receipt_count": 0,
        "implementation_claim": "NONE"
      }
    }
  },
  "$defs": {
    "evidenceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_key", "class", "path", "locator_kind", "locator", "stage_role"],
      "properties": {
        "evidence_key": {"type": "string", "pattern": "^R60:pattern_match_ownership_split:(STATIC_SEMANTICS|DYNAMIC_LOWERING):STRUCTURAL$"},
        "class": {"const": "CONTRACT_RULE_ID"},
        "path": {"const": "spec/contracts/pattern-match-ownership-split-trace-closure-r1.json"},
        "locator_kind": {"const": "REGISTRY_ID"},
        "locator": {"type": "string", "pattern": "^PMOSTC-R0(0[1-9]|1[0-4])$"},
        "stage_role": {"enum": ["STATIC_SEMANTICS", "DYNAMIC_LOWERING"]}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "stage", "outcome", "predecessor_disposition", "disposition", "evidence_keys", "delegate_feature_id", "not_applicable"],
      "properties": {
        "feature_id": {"const": "pattern_match_ownership_split"},
        "stage": {"enum": ["STATIC_SEMANTICS", "DYNAMIC_LOWERING"]},
        "outcome": {"const": null},
        "predecessor_disposition": {"const": "APPLICABLE_BLOCKED_BY_GAP"},
        "disposition": {"const": "BOUND_DIRECT"},
        "evidence_keys": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^R60:"}},
        "delegate_feature_id": {"const": null},
        "not_applicable": {"const": null}
      }
    },
    "traceCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "audit_case_id", "feature_id", "class", "contract_pointer", "trace_role", "execution_state"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^PMOSTC-AC-0(0[1-9]|1[0-2])$"},
        "audit_case_id": {"type": "string", "pattern": "^OWN([1-9]|1[0-2])$"},
        "feature_id": {"const": "pattern_match_ownership_split"},
        "class": {"enum": ["POSITIVE", "BOUNDARY", "REJECT"]},
        "contract_pointer": {"type": "string", "pattern": "^/acceptance_cases/(0|[1-9]|1[01])$"},
        "trace_role": {"const": "SUPPORTING_DESIGN_STATIC_NOT_STAGE_TRANSITION"},
        "execution_state": {"const": "DESIGN_STATIC_NOT_RUN"}
      }
    }
  }
}
