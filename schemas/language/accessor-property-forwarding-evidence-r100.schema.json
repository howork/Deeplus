{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplus.dev/schemas/language/accessor-property-forwarding-evidence-r100.schema.json",
  "title": "Deeplus accessor/property/forwarding R100 trace overlay",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "status", "feature_ids", "evidence_entries", "bindings", "supersedes_binding_cells", "guards"],
  "properties": {
    "schema": {"const": "deeplus.accessor-property-forwarding-evidence/r100"},
    "revision": {"const": "r100-accessor-property-forwarding-trace-r1"},
    "status": {"const": "LOCAL_DESIGN_STATIC_EVIDENCE_OVERLAY"},
    "feature_ids": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"type": "string"}},
    "evidence_entries": {
      "type": "array",
      "minItems": 35,
      "maxItems": 35,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_key", "class", "path", "locator_kind", "locator", "stage_role"],
        "properties": {
          "evidence_key": {"type": "string", "minLength": 1},
          "class": {"enum": ["CONTRACT_RULE_ID", "ACCEPTANCE_CASE_SET"]},
          "path": {"const": "spec/contracts/accessor-property-forwarding-r100.json"},
          "locator_kind": {"enum": ["REGISTRY_ID", "JSON_POINTER"]},
          "locator": {"type": "string", "minLength": 1},
          "stage_role": {"type": "string", "minLength": 1}
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 35,
      "maxItems": 35,
      "items": {"$ref": "#/$defs/binding"}
    },
    "supersedes_binding_cells": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predecessor_overlay_path", "cells"],
      "properties": {
        "predecessor_overlay_path": {"const": "spec/traceability/implementation-target-profile-r1/global-trace-closure-evidence-r1.json"},
        "cells": {"type": "array", "minItems": 32, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/cell"}}
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_p0", "feature_p1", "product_lanes", "github_publication", "product_execution_receipt_count"],
      "properties": {
        "semantic_p0": {"const": 0},
        "feature_p1": {"const": "22_OPEN_UNCHANGED"},
        "product_lanes": {"const": "15_OF_15_NOT_RUN"},
        "github_publication": {"const": "NOT_PERFORMED"},
        "product_execution_receipt_count": {"const": 0}
      }
    }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "stage", "outcome"],
      "properties": {
        "feature_id": {"type": "string"},
        "stage": {"enum": ["STATIC_SEMANTICS", "DYNAMIC_LOWERING", "CONFORMANCE_TESTS"]},
        "outcome": {"type": ["string", "null"], "enum": ["POSITIVE", "BOUNDARY", "REJECT", null]}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "stage", "outcome", "predecessor_disposition", "disposition", "evidence_keys", "delegate_feature_id", "not_applicable"],
      "properties": {
        "feature_id": {"type": "string"},
        "stage": {"enum": ["STATIC_SEMANTICS", "DYNAMIC_LOWERING", "CONFORMANCE_TESTS"]},
        "outcome": {"type": ["string", "null"], "enum": ["POSITIVE", "BOUNDARY", "REJECT", null]},
        "predecessor_disposition": {"const": "APPLICABLE_BLOCKED_BY_GAP"},
        "disposition": {"enum": ["BOUND_DIRECT", "NOT_APPLICABLE"]},
        "evidence_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "delegate_feature_id": {"type": "null"},
        "not_applicable": {
          "type": ["object", "null"],
          "properties": {
            "reason_code": {"const": "NA_DYNAMIC_STATIC_ONLY_NO_RUNTIME_BEHAVIOR"},
            "authority_boundary": {"const": "MIR_RUNTIME_AUTHORITY"},
            "rationale": {"type": "string", "minLength": 1},
            "justification_evidence_keys": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          },
          "required": ["reason_code", "authority_boundary", "rationale", "justification_evidence_keys"],
          "additionalProperties": false
        }
      }
    }
  }
}
