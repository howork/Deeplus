{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplus-lang.org/schemas/language/numeric-array-shape-inferred-literal-r1.schema.json",
  "title": "Deeplus shape-inferred NumericArray literal contract R1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "revision",
    "canonical_baseline_commit",
    "local_predecessor_commit",
    "candidate_status",
    "language_status",
    "source_activation",
    "current_binding",
    "feature_ids",
    "authority_fence",
    "syntax_contract",
    "ast_contract",
    "static_semantics",
    "diagnostic_contract",
    "lowering_contract",
    "tooling_contract",
    "rules",
    "acceptance_cases",
    "machine_acceptance"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/language/numeric-array-shape-inferred-literal-r1.schema.json"
    },
    "schema": {
      "const": "deeplus.numeric-array-shape-inferred-literal/r1"
    },
    "revision": {
      "const": "r56-local-numeric-array-shape-inferred-literal-r1"
    },
    "canonical_baseline_commit": {
      "const": "39a5d50cc770341c4b9776d00d84520b780d0c62"
    },
    "local_predecessor_commit": {
      "const": "f4e194d414a024b1fbf93549cdbe3d0cc59fb810"
    },
    "candidate_status": {
      "const": "APPROVED_NOT_INTEGRATED_LOCAL_CANDIDATE"
    },
    "language_status": {
      "const": "STABLE_DESIGN"
    },
    "source_activation": {
      "const": "none"
    },
    "current_binding": {
      "const": false
    },
    "feature_ids": {
      "type": "array",
      "prefixItems": [
        {
          "const": "numeric_array_shape_inferred_column_vector_semicolon_msp"
        },
        {
          "const": "numeric_array_shape_inferred_value_literal"
        },
        {
          "const": "numeric_array_vector_orientation_witness_msp"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true
    },
    "authority_fence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "new_source_surface_count",
        "new_ast_identity_count",
        "new_mir_operation_kind_count",
        "backend_layout_or_abi_selection_count",
        "preview_feature_activation_count",
        "semantic_p0",
        "feature_p1",
        "m13_actions",
        "product_lanes",
        "github_publication",
        "evidence_level"
      ],
      "properties": {
        "new_source_surface_count": { "const": 0 },
        "new_ast_identity_count": { "const": 0 },
        "new_mir_operation_kind_count": { "const": 0 },
        "backend_layout_or_abi_selection_count": { "const": 0 },
        "preview_feature_activation_count": { "const": 0 },
        "semantic_p0": { "const": 0 },
        "feature_p1": { "const": "22_OPEN_UNCHANGED" },
        "m13_actions": { "const": "4_OPEN_UNCHANGED" },
        "product_lanes": { "const": "15_OF_15_NOT_RUN" },
        "github_publication": { "const": "SUSPENDED" },
        "evidence_level": { "const": "E2_STRUCTURED_STATIC" }
      }
    },
    "syntax_contract": {
      "$ref": "#/$defs/syntaxContract"
    },
    "ast_contract": {
      "$ref": "#/$defs/astContract"
    },
    "static_semantics": {
      "$ref": "#/$defs/staticSemantics"
    },
    "diagnostic_contract": {
      "$ref": "#/$defs/diagnosticContract"
    },
    "lowering_contract": {
      "$ref": "#/$defs/loweringContract"
    },
    "tooling_contract": {
      "$ref": "#/$defs/toolingContract"
    },
    "rules": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "acceptance_cases": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/acceptanceCase"
      }
    },
    "machine_acceptance": {
      "$ref": "#/$defs/machineAcceptance"
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "orientation": {
      "enum": [
        "ROW",
        "COLUMN",
        "MATRIX"
      ]
    },
    "inferredForm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form_id",
        "production_id",
        "surface",
        "separator",
        "minimum_element_count",
        "rank",
        "shape_expression",
        "orientation"
      ],
      "properties": {
        "form_id": {
          "enum": [
            "ROW_COMMA",
            "COLUMN_SEMICOLON"
          ]
        },
        "production_id": {
          "enum": [
            "ShapeInferredArrayLiteral",
            "ShapeInferredColumnVectorLiteral"
          ]
        },
        "surface": { "$ref": "#/$defs/nonemptyString" },
        "separator": {
          "enum": [
            ",",
            ";"
          ]
        },
        "minimum_element_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "rank": { "const": 1 },
        "shape_expression": { "const": "[N]" },
        "orientation": {
          "enum": [
            "ROW",
            "COLUMN"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "form_id": { "const": "ROW_COMMA" } },
            "required": [ "form_id" ]
          },
          "then": {
            "properties": {
              "production_id": { "const": "ShapeInferredArrayLiteral" },
              "separator": { "const": "," },
              "minimum_element_count": { "const": 1 },
              "orientation": { "const": "ROW" }
            }
          }
        },
        {
          "if": {
            "properties": { "form_id": { "const": "COLUMN_SEMICOLON" } },
            "required": [ "form_id" ]
          },
          "then": {
            "properties": {
              "production_id": { "const": "ShapeInferredColumnVectorLiteral" },
              "separator": { "const": ";" },
              "minimum_element_count": { "const": 2 },
              "orientation": { "const": "COLUMN" }
            }
          }
        }
      ]
    },
    "exactRankTwoForm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "rank",
        "shape_expression",
        "orientation"
      ],
      "properties": {
        "surface": { "$ref": "#/$defs/nonemptyString" },
        "rank": { "const": 2 },
        "shape_expression": {
          "enum": [
            "[1,N]",
            "[N,1]"
          ]
        },
        "orientation": { "const": "MATRIX" }
      }
    },
    "syntaxContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_production",
        "forms",
        "nonempty_required",
        "mixed_separator_admitted",
        "exact_rank_two_forms_distinct",
        "surface_equivalence_count_between_inferred_rank_one_and_exact_rank_two"
      ],
      "properties": {
        "root_production": { "const": "NumericArrayLiteral" },
        "forms": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/inferredForm" }
        },
        "nonempty_required": { "const": true },
        "mixed_separator_admitted": { "const": false },
        "exact_rank_two_forms_distinct": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/exactRankTwoForm" }
        },
        "surface_equivalence_count_between_inferred_rank_one_and_exact_rank_two": { "const": 0 }
      }
    },
    "astVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "form_id", "cst_kind", "ast_kind" ],
      "properties": {
        "form_id": { "enum": [ "ROW_COMMA", "COLUMN_SEMICOLON" ] },
        "cst_kind": {
          "enum": [
            "CST/ShapeInferredArrayLiteral",
            "CST/ShapeInferredColumnVectorLiteral"
          ]
        },
        "ast_kind": {
          "enum": [
            "AST/ShapeInferredArrayLiteral",
            "AST/ShapeInferredColumnVectorLiteral"
          ]
        }
      }
    },
    "astContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wrapper_node",
        "variants",
        "required_fields",
        "aggregate_kind_id",
        "inferred_rank",
        "shape_rule",
        "element_source_order_preserved",
        "backend_layout_field_count",
        "abi_identity_field_count"
      ],
      "properties": {
        "wrapper_node": { "const": "AST/NumericArrayLiteral" },
        "variants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/astVariant" }
        },
        "required_fields": {
          "type": "array",
          "prefixItems": [
            { "const": "form_id" },
            { "const": "orientation" },
            { "const": "element_expr_ids" },
            { "const": "inferred_rank" },
            { "const": "inferred_shape" },
            { "const": "aggregate_kind_id" },
            { "const": "source_span" }
          ],
          "items": false,
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true
        },
        "aggregate_kind_id": { "const": "NUMERIC_ARRAY" },
        "inferred_rank": { "const": 1 },
        "shape_rule": { "$ref": "#/$defs/nonemptyString" },
        "element_source_order_preserved": { "const": true },
        "backend_layout_field_count": { "const": 0 },
        "abi_identity_field_count": { "const": 0 }
      }
    },
    "staticSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admission_predicate",
        "element_count_rule",
        "contextual_check",
        "context_free_inference",
        "row_result",
        "column_result",
        "exact_rank_two_nonidentity",
        "implicit_broadcast_count",
        "implicit_element_conversion_search_count",
        "runtime_shape_inference_count"
      ],
      "properties": {
        "admission_predicate": { "const": "NumericArrayElementAdmitted" },
        "element_count_rule": { "$ref": "#/$defs/nonemptyString" },
        "contextual_check": { "$ref": "#/$defs/nonemptyString" },
        "context_free_inference": { "$ref": "#/$defs/nonemptyString" },
        "row_result": { "$ref": "#/$defs/nonemptyString" },
        "column_result": { "$ref": "#/$defs/nonemptyString" },
        "exact_rank_two_nonidentity": { "const": true },
        "implicit_broadcast_count": { "const": 0 },
        "implicit_element_conversion_search_count": { "const": 0 },
        "runtime_shape_inference_count": { "const": 0 }
      }
    },
    "diagnosticPriority": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "rank", "condition" ],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 8 },
        "condition": { "$ref": "#/$defs/nonemptyString" },
        "diagnostic_id": { "$ref": "#/$defs/nonemptyString" },
        "diagnostic_owner": { "$ref": "#/$defs/nonemptyString" }
      },
      "oneOf": [
        { "required": [ "diagnostic_id" ] },
        { "required": [ "diagnostic_owner" ] }
      ]
    },
    "newDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_id",
        "severity",
        "owner",
        "message",
        "recovery_ast_count",
        "hir_residue_count",
        "mir_residue_count"
      ],
      "properties": {
        "diagnostic_id": { "const": "NUMARR_ELEMENT_TYPE_MISMATCH" },
        "severity": { "const": "error" },
        "owner": { "const": "checker" },
        "message": { "$ref": "#/$defs/nonemptyString" },
        "recovery_ast_count": { "const": 0 },
        "hir_residue_count": { "const": 0 },
        "mir_residue_count": { "const": 0 }
      }
    },
    "diagnosticContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "priority", "new_diagnostics" ],
      "properties": {
        "priority": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/diagnosticPriority" }
        },
        "new_diagnostics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/newDiagnostic" }
        }
      }
    },
    "shapeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "dimensions",
        "orientation_source",
        "backend_layout_selected",
        "abi_identity_selected"
      ],
      "properties": {
        "rank": { "const": 1 },
        "dimensions": { "const": "[N]" },
        "orientation_source": { "const": "AST.orientation" },
        "backend_layout_selected": { "const": false },
        "abi_identity_selected": { "const": false }
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_kind",
        "semantic_operation_id",
        "operation_count_on_success",
        "payload",
        "shape_carrier"
      ],
      "properties": {
        "operation_kind": { "const": "AGGREGATE_ASSEMBLE" },
        "semantic_operation_id": { "const": "DM-SEMOP-AGGREGATE-ASSEMBLE-R1" },
        "operation_count_on_success": { "const": 1 },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [ "aggregate_kind_id" ],
          "properties": {
            "aggregate_kind_id": { "const": "NUMERIC_ARRAY" }
          }
        },
        "shape_carrier": { "$ref": "#/$defs/nonemptyString" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "partial_publish_count", "publish_point", "assembly_count_on_element_failure" ],
      "properties": {
        "partial_publish_count": { "const": 0 },
        "publish_point": { "$ref": "#/$defs/nonemptyString" },
        "assembly_count_on_element_failure": { "const": 0 }
      }
    },
    "failureCleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cleanup_order",
        "cleanup_scope",
        "failing_element_result_published",
        "unevaluated_suffix_element_count"
      ],
      "properties": {
        "cleanup_order": { "const": "REVERSE_INITIALIZATION_ORDER" },
        "cleanup_scope": { "$ref": "#/$defs/nonemptyString" },
        "failing_element_result_published": { "const": false },
        "unevaluated_suffix_element_count": { "$ref": "#/$defs/nonemptyString" }
      }
    },
    "loweringContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hir_plan_id",
        "aggregate_kind_id",
        "shape_identity",
        "element_evaluation_order",
        "element_evaluation_count_each",
        "element_lowering",
        "assembly",
        "publication",
        "failure_cleanup",
        "new_mir_operation_kind_count",
        "runtime_or_provider_lookup_count",
        "backend_layout_or_abi_decision_count",
        "product_execution"
      ],
      "properties": {
        "hir_plan_id": { "const": "NUMERIC_ARRAY_SHAPE_INFERRED_LITERAL_PLAN_R1" },
        "aggregate_kind_id": { "const": "NUMERIC_ARRAY" },
        "shape_identity": { "$ref": "#/$defs/shapeIdentity" },
        "element_evaluation_order": { "const": "SOURCE_LEFT_TO_RIGHT" },
        "element_evaluation_count_each": { "const": 1 },
        "element_lowering": { "$ref": "#/$defs/nonemptyString" },
        "assembly": { "$ref": "#/$defs/assembly" },
        "publication": { "$ref": "#/$defs/publication" },
        "failure_cleanup": { "$ref": "#/$defs/failureCleanup" },
        "new_mir_operation_kind_count": { "const": 0 },
        "runtime_or_provider_lookup_count": { "const": 0 },
        "backend_layout_or_abi_decision_count": { "const": 0 },
        "product_execution": { "const": "NOT_RUN" }
      }
    },
    "toolingContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "formatter", "lsp", "formatter_execution", "lsp_execution" ],
      "properties": {
        "formatter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "row_separator",
            "column_separator",
            "orientation_rewrite_count",
            "inferred_to_exact_shape_rewrite_count",
            "idempotence_required"
          ],
          "properties": {
            "row_separator": { "const": ", " },
            "column_separator": { "const": "; " },
            "orientation_rewrite_count": { "const": 0 },
            "inferred_to_exact_shape_rewrite_count": { "const": 0 },
            "idempotence_required": { "const": true }
          }
        },
        "lsp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hover_fields",
            "completion_changes_orientation_count",
            "diagnostic_priority_matches_checker"
          ],
          "properties": {
            "hover_fields": {
              "type": "array",
              "prefixItems": [
                { "const": "normalized_element_type" },
                { "const": "rank" },
                { "const": "shape" },
                { "const": "orientation" }
              ],
              "items": false,
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true
            },
            "completion_changes_orientation_count": { "const": 0 },
            "diagnostic_priority_matches_checker": { "const": true }
          }
        },
        "formatter_execution": { "const": "NOT_RUN" },
        "lsp_execution": { "const": "NOT_RUN" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "rule_id", "text" ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^NASIL-R(00[1-9]|01[0-4])$"
        },
        "text": { "$ref": "#/$defs/nonemptyString" }
      }
    },
    "assertionValue": {
      "type": [ "string", "integer", "boolean", "array" ]
    },
    "acceptanceCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "class",
        "feature_id",
        "source_or_subject",
        "expected",
        "diagnostic_or_null",
        "assertions",
        "execution_state"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^NASIL-AC-[A-Z]+-(POS|BOUND|REJECT|FAIL)-[0-9]{3}$"
        },
        "class": { "enum": [ "POSITIVE", "BOUNDARY", "REJECT" ] },
        "feature_id": {
          "enum": [
            "numeric_array_shape_inferred_column_vector_semicolon_msp",
            "numeric_array_shape_inferred_value_literal",
            "numeric_array_vector_orientation_witness_msp"
          ]
        },
        "source_or_subject": { "$ref": "#/$defs/nonemptyString" },
        "expected": {
          "enum": [
            "ADMIT",
            "REJECT",
            "PROPAGATE_ELEMENT_FAILURE"
          ]
        },
        "diagnostic_or_null": {
          "type": [ "string", "null" ]
        },
        "assertions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/assertionValue" }
        },
        "execution_state": { "const": "DESIGN_STATIC_NOT_RUN" }
      }
    },
    "machineAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_count",
        "form_count",
        "rule_count",
        "diagnostic_priority_count",
        "new_diagnostic_count",
        "acceptance_case_count",
        "positive_case_count",
        "boundary_case_count",
        "reject_case_count",
        "dynamic_failure_case_count",
        "aggregate_assemble_count_on_success",
        "new_mir_operation_kind_count",
        "backend_layout_or_abi_selection_count",
        "semantic_p0",
        "feature_p1",
        "m13_actions",
        "product_lanes",
        "github_publication"
      ],
      "properties": {
        "feature_count": { "const": 3 },
        "form_count": { "const": 2 },
        "rule_count": { "const": 14 },
        "diagnostic_priority_count": { "const": 8 },
        "new_diagnostic_count": { "const": 1 },
        "acceptance_case_count": { "const": 11 },
        "positive_case_count": { "const": 3 },
        "boundary_case_count": { "const": 4 },
        "reject_case_count": { "const": 4 },
        "dynamic_failure_case_count": { "const": 1 },
        "aggregate_assemble_count_on_success": { "const": 1 },
        "new_mir_operation_kind_count": { "const": 0 },
        "backend_layout_or_abi_selection_count": { "const": 0 },
        "semantic_p0": { "const": 0 },
        "feature_p1": { "const": "22_OPEN_UNCHANGED" },
        "m13_actions": { "const": "4_OPEN_UNCHANGED" },
        "product_lanes": { "const": "15_OF_15_NOT_RUN" },
        "github_publication": { "const": "SUSPENDED" }
      }
    }
  }
}
