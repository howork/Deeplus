{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplus.dev/schemas/language/pattern-clause-exhaustiveness-evidence-r1.schema.json",
  "title": "Deeplus R61 Pattern Clause Exhaustiveness Evidence Overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "revision",
    "canonical_baseline_commit",
    "local_predecessor_commit",
    "candidate_status",
    "feature_ids",
    "evidence_entries",
    "bindings",
    "acceptance_cases",
    "counts",
    "guards"
  ],
  "properties": {
    "$schema": {"const": "../../../schemas/language/pattern-clause-exhaustiveness-evidence-r1.schema.json"},
    "schema": {"const": "deeplus.pattern-clause-exhaustiveness-evidence/r1"},
    "revision": {"const": "r61-local-pattern-clause-exhaustiveness-trace-closure-r1"},
    "canonical_baseline_commit": {"const": "39a5d50cc770341c4b9776d00d84520b780d0c62"},
    "local_predecessor_commit": {"const": "2db4f483ffdcb281ef765def67e510e63917500c"},
    "candidate_status": {"const": "NONCANONICAL_DESIGN_STATIC_EVIDENCE_OVERLAY"},
    "feature_ids": {"const": ["clause_pattern_heads", "match_exhaustiveness_phase_a"]},
    "evidence_entries": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceEntry"}},
    "bindings": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/binding"}},
    "acceptance_cases": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/traceCase"}},
    "counts": {
      "const": {
        "feature_count": 2,
        "evidence_entry_count": 5,
        "binding_count": 5,
        "contract_acceptance_case_count": 22,
        "acceptance_binding_set_count": 4,
        "acceptance_bound_case_count": 19,
        "acceptance_stage_transition_count": 4,
        "predecessor_blocked_cell_count": 5,
        "overlay_bound_direct_transition_count": 5,
        "overlay_bound_delegated_transition_count": 0,
        "overlay_not_applicable_transition_count": 0,
        "predecessor_cumulative_overlay_binding_count": 115,
        "post_overlay_cumulative_binding_count": 120,
        "predecessor_total_bound_direct_cell_count": 2452,
        "predecessor_total_bound_delegated_cell_count": 3,
        "predecessor_total_not_applicable_cell_count": 502,
        "predecessor_total_blocked_cell_count": 1264,
        "post_overlay_total_bound_direct_cell_count": 2457,
        "post_overlay_total_bound_delegated_cell_count": 3,
        "post_overlay_total_not_applicable_cell_count": 502,
        "post_overlay_total_blocked_cell_count": 1259,
        "post_overlay_missing_cell_count": 0,
        "post_overlay_conflict_cell_count": 0
      }
    },
    "guards": {
      "const": {
        "target_feature_count": 469,
        "target_feature_id_list_sha256": "86414f1c8690515497a5a4c284cfcc22084b0ff2962b8c38b073ac79a6b40435",
        "excluded_feature_count": 254,
        "excluded_feature_id_list_sha256": "8bf7368f5a219fc17fca9d7e5c84adc0b5f8975eb1a590a04ab15ce92b8c10b7",
        "transitioned_cell_count": 5,
        "excluded_related_feature_transition_count": 0,
        "other_cell_transition_count": 0,
        "source_activation": "none",
        "surface_change_count": 0,
        "ast_identity_change_count": 0,
        "hir_identity_change_count": 0,
        "mir_operation_kind_change_count": 0,
        "semantic_p0": 0,
        "feature_p1": "22_OPEN_UNCHANGED",
        "m13_actions": "4_OPEN_UNCHANGED",
        "product_lanes": "15_OF_15_NOT_RUN",
        "github_publication": "SUSPENDED",
        "product_execution_receipt_count": 0,
        "implementation_claim": "NONE"
      }
    }
  },
  "$defs": {
    "evidenceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_key", "class", "path", "locator_kind", "locator", "stage_role"],
      "properties": {
        "evidence_key": {"type": "string", "pattern": "^R61:(clause_pattern_heads|match_exhaustiveness_phase_a):(DYNAMIC_LOWERING|CONFORMANCE_TESTS):(STRUCTURAL|BOUNDARY|REJECT)$"},
        "class": {"enum": ["CONTRACT_RULE_ID", "ACCEPTANCE_CASE_SET"]},
        "path": {"const": "spec/contracts/pattern-clause-exhaustiveness-trace-closure-r1.json"},
        "locator_kind": {"enum": ["REGISTRY_ID", "JSON_POINTER"]},
        "locator": {"type": "string", "minLength": 1},
        "stage_role": {"enum": ["DYNAMIC_LOWERING", "CONFORMANCE_TESTS:BOUNDARY", "CONFORMANCE_TESTS:REJECT"]}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "stage", "outcome", "predecessor_disposition", "disposition", "evidence_keys", "delegate_feature_id", "not_applicable"],
      "properties": {
        "feature_id": {"enum": ["clause_pattern_heads", "match_exhaustiveness_phase_a"]},
        "stage": {"enum": ["DYNAMIC_LOWERING", "CONFORMANCE_TESTS"]},
        "outcome": {"enum": [null, "BOUNDARY", "REJECT"]},
        "predecessor_disposition": {"const": "APPLICABLE_BLOCKED_BY_GAP"},
        "disposition": {"const": "BOUND_DIRECT"},
        "evidence_keys": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^R61:"}},
        "delegate_feature_id": {"const": null},
        "not_applicable": {"const": null}
      }
    },
    "traceCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "feature_id", "outcome", "contract_pointer", "acceptance_case_ids", "disposition", "delegate_feature_id", "execution_state"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^R61-TRACE-00[1-4]$"},
        "feature_id": {"enum": ["clause_pattern_heads", "match_exhaustiveness_phase_a"]},
        "outcome": {"enum": ["BOUNDARY", "REJECT"]},
        "contract_pointer": {"type": "string", "pattern": "^/acceptance_bindings/(clause_pattern_heads|match_exhaustiveness_phase_a)/(BOUNDARY|REJECT)$"},
        "acceptance_case_ids": {"type": "array", "minItems": 4, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^PCETC-AC-0(0[4-9]|1[0-9]|2[0-2])$"}},
        "disposition": {"const": "BOUND_DIRECT"},
        "delegate_feature_id": {"const": null},
        "execution_state": {"const": "DESIGN_STATIC_NOT_RUN"}
      }
    }
  }
}
