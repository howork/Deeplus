{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplus.dev/schemas/language/pattern-clause-exhaustiveness-trace-closure-r1.schema.json",
  "title": "Deeplus R61 Pattern Clause Exhaustiveness Trace Closure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "revision",
    "canonical_baseline_commit",
    "local_predecessor_commit",
    "candidate_status",
    "language_status",
    "source_activation",
    "current_binding",
    "feature_ids",
    "authority_fence",
    "scope_fence",
    "existing_operation_alignment",
    "clause_dispatch_and_failure_law",
    "declarative_partition_admission_law",
    "match_exhaustiveness_law",
    "diagnostic_selection_law",
    "failure_residue_law",
    "rules",
    "acceptance_cases",
    "acceptance_bindings",
    "machine_acceptance"
  ],
  "properties": {
    "$schema": {"const": "../../schemas/language/pattern-clause-exhaustiveness-trace-closure-r1.schema.json"},
    "schema": {"const": "deeplus.pattern-clause-exhaustiveness-trace-closure/r1"},
    "revision": {"const": "r61-local-pattern-clause-exhaustiveness-trace-closure-r1"},
    "canonical_baseline_commit": {"const": "39a5d50cc770341c4b9776d00d84520b780d0c62"},
    "local_predecessor_commit": {"const": "2db4f483ffdcb281ef765def67e510e63917500c"},
    "candidate_status": {"const": "APPROVED_NOT_INTEGRATED_LOCAL_CANDIDATE"},
    "language_status": {"const": "STABLE_DESIGN"},
    "source_activation": {"const": "none"},
    "current_binding": {"const": false},
    "feature_ids": {"const": ["clause_pattern_heads", "match_exhaustiveness_phase_a"]},
    "authority_fence": {
      "const": {
        "new_source_surface_count": 0,
        "new_ast_identity_count": 0,
        "new_hir_identity_count": 0,
        "new_mir_operation_kind_count": 0,
        "semantic_p0": 0,
        "feature_p1": "22_OPEN_UNCHANGED",
        "m13_actions": "4_OPEN_UNCHANGED",
        "product_lanes": "15_OF_15_NOT_RUN",
        "github_publication": "SUSPENDED",
        "evidence_level": "E2_STRUCTURED_STATIC"
      }
    },
    "scope_fence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transitioned_cells", "excluded_related_features", "excluded_related_feature_transition_count", "other_target_cell_transition_count"],
      "properties": {
        "transitioned_cells": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/transitionCell"}},
        "excluded_related_features": {"const": ["clause_pattern_head_semantic_partition_core", "declarative_clause_pattern_head_law", "declarative_function_clause_block_msp", "match_otherwise_default_arm", "pattern_match_ownership_split"]},
        "excluded_related_feature_transition_count": {"const": 0},
        "other_target_cell_transition_count": {"const": 0}
      }
    },
    "existing_operation_alignment": {"type": "object"},
    "clause_dispatch_and_failure_law": {"type": "object"},
    "declarative_partition_admission_law": {"type": "object"},
    "match_exhaustiveness_law": {"type": "object"},
    "diagnostic_selection_law": {"type": "object"},
    "failure_residue_law": {"type": "object"},
    "rules": {"type": "array", "minItems": 16, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/rule"}},
    "acceptance_cases": {"type": "array", "minItems": 22, "maxItems": 22, "uniqueItems": true, "items": {"$ref": "#/$defs/acceptanceCase"}},
    "acceptance_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clause_pattern_heads", "match_exhaustiveness_phase_a"],
      "properties": {
        "clause_pattern_heads": {
          "type": "object",
          "additionalProperties": false,
          "required": ["BOUNDARY", "REJECT"],
          "properties": {
            "BOUNDARY": {"const": ["PCETC-AC-004", "PCETC-AC-005", "PCETC-AC-006", "PCETC-AC-007"]},
            "REJECT": {"const": ["PCETC-AC-008", "PCETC-AC-009", "PCETC-AC-010", "PCETC-AC-011", "PCETC-AC-012"]}
          }
        },
        "match_exhaustiveness_phase_a": {
          "type": "object",
          "additionalProperties": false,
          "required": ["BOUNDARY", "REJECT"],
          "properties": {
            "BOUNDARY": {"const": ["PCETC-AC-013", "PCETC-AC-014", "PCETC-AC-015", "PCETC-AC-016", "PCETC-AC-017"]},
            "REJECT": {"const": ["PCETC-AC-018", "PCETC-AC-019", "PCETC-AC-020", "PCETC-AC-021", "PCETC-AC-022"]}
          }
        }
      }
    },
    "machine_acceptance": {
      "const": {
        "feature_count": 2,
        "rule_count": 16,
        "acceptance_case_count": 22,
        "positive_case_count": 3,
        "boundary_case_count": 9,
        "reject_case_count": 10,
        "acceptance_binding_set_count": 4,
        "acceptance_bound_case_count": 19,
        "overlay_binding_count": 5,
        "predecessor_blocked_cell_count": 5,
        "overlay_bound_direct_transition_count": 5,
        "overlay_bound_delegated_transition_count": 0,
        "overlay_not_applicable_transition_count": 0,
        "predecessor_cumulative_overlay_binding_count": 115,
        "post_overlay_cumulative_binding_count": 120,
        "predecessor_total_bound_direct_cell_count": 2452,
        "predecessor_total_bound_delegated_cell_count": 3,
        "predecessor_total_not_applicable_cell_count": 502,
        "predecessor_total_blocked_cell_count": 1264,
        "post_overlay_total_bound_direct_cell_count": 2457,
        "post_overlay_total_bound_delegated_cell_count": 3,
        "post_overlay_total_not_applicable_cell_count": 502,
        "post_overlay_total_blocked_cell_count": 1259,
        "post_overlay_missing_cell_count": 0,
        "post_overlay_conflict_cell_count": 0,
        "new_operation_count": 0,
        "subject_evaluation_count": 1,
        "logical_final_commit_count_on_clause_success": 1,
        "failure_residue_count": 0,
        "source_order_overlap_winner_count": 0,
        "terminal_no_match_runtime_residue_count": 0,
        "excluded_related_feature_transition_count": 0,
        "other_target_cell_transition_count": 0
      }
    }
  },
  "$defs": {
    "transitionCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "stage", "outcome", "predecessor_disposition", "disposition"],
      "properties": {
        "feature_id": {"enum": ["clause_pattern_heads", "match_exhaustiveness_phase_a"]},
        "stage": {"enum": ["DYNAMIC_LOWERING", "CONFORMANCE_TESTS"]},
        "outcome": {"enum": [null, "BOUNDARY", "REJECT"]},
        "predecessor_disposition": {"const": "APPLICABLE_BLOCKED_BY_GAP"},
        "disposition": {"const": "BOUND_DIRECT"}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "text"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^PCETC-R0(0[1-9]|1[0-6])$"},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "acceptanceCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "audit_case_id", "class", "feature_id", "source_or_subject", "expected", "diagnostic_or_null", "assertions", "execution_state"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^PCETC-AC-0(0[1-9]|1[0-9]|2[0-2])$"},
        "audit_case_id": {"type": "string", "pattern": "^(CLAUSE([1-9]|1[0-2])|MATCH[BR][1-5])$"},
        "class": {"enum": ["POSITIVE", "BOUNDARY", "REJECT"]},
        "feature_id": {"enum": ["clause_pattern_heads", "match_exhaustiveness_phase_a"]},
        "source_or_subject": {"type": "string", "minLength": 1},
        "expected": {"type": "string", "minLength": 1},
        "diagnostic_or_null": {"type": ["string", "null"]},
        "assertions": {"type": "object"},
        "execution_state": {"const": "DESIGN_STATIC_NOT_RUN"}
      }
    }
  }
}
