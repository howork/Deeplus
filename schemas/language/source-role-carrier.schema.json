          ]
        }
      ],
      "expected": "admitted"
    },
    {
      "fixture_id": "SRCROLE-CARRIER-POS-PREVIEW-001",
      "profile": "R4_NAME_RESOLUTION_MODULES",
      "package_id": "PackageId:fixture",
      "targets": [
        {
          "target_id": "TargetId:fixture.lib",
