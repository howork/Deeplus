{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplus-lang.org/schema/r51f3/source-role-carrier.schema.json",
  "title": "Deeplus project source-role carrier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "package_id",
    "targets",
    "package_module_source_graph_sha256",
    "source_files"
  ],
  "properties": {
    "schema": {
      "const": "deeplus.source-role-carrier/r2"
    },
    "profile": {
      "const": "R4_NAME_RESOLUTION_MODULES"
    },
    "package_id": {
      "type": "string",
      "pattern": "^PackageId:[^\\s]+$"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "canonical_manifest_target_name",
          "target_kind",
          "source_role_policy",
          "activation_profile"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "pattern": "^TargetId:[^\\s]+$"
          },
          "canonical_manifest_target_name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "target_kind": {
            "enum": [
              "library",
              "executable",
              "script"
            ]
          },
          "source_role_policy": {
            "enum": [
              "library",
              "executable",
              "script"
            ]
          },
          "activation_profile": {
            "enum": [
              "stable",
              "preview"
            ]
          }
        },
        "oneOf": [
          {
            "properties": {
              "target_kind": {
                "const": "library"
              },
              "source_role_policy": {
                "const": "library"
              }
            }
          },
          {
            "properties": {
              "target_kind": {
                "const": "executable"
              },
              "source_role_policy": {
                "const": "executable"
              }
            }
          },
          {
            "properties": {
              "target_kind": {
                "const": "script"
              },
              "source_role_policy": {
                "const": "script"
              }
            }
          }
        ]
      }
    },
    "package_module_source_graph_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "source_role",
          "source_file_id",
          "target_id",
          "activation_profile",
          "module_id",
          "module_path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source_role": {
            "enum": [
              "library",
              "executable",
              "script"
            ]
          },
          "source_file_id": {
            "type": "string",
            "pattern": "^SourceFileId:[^\\s]+$"
          },
          "target_id": {
            "type": "string",
            "pattern": "^TargetId:[^\\s]+$"
          },
          "activation_profile": {
            "enum": [
              "stable",
              "preview"
            ]
          },
          "module_id": {
            "type": "string",
            "pattern": "^ModuleId:[^\\s]+$"
          },
          "module_path": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        }
      }
    }
  },
  "x-deeplus-identity": {
    "PackageId": "canonical package key encoding",
    "TargetId": "package_id + canonical_manifest_target_name + target_kind",
    "SourceFileId": "target_id + normalized project-root-relative path",
    "forbidden_inputs": [
      "absolute_path",
      "source_order",
      "file_enumeration_order",
      "timestamp",
      "content_digest"
    ]
  },
  "x-deeplus-normalized-path-uniqueness": {
    "algorithm": "normalize each path to a project-root-relative lexical path, then insert into a map before parsing; a second row with the same normalized key is rejected even when its source_role differs",
    "comparison": "Unicode scalar exact after slash normalization and removal of dot segments; case folding is a host policy performed before this contract",
    "duplicate_same_role": "SOURCE_ROLE_CARRIER_CONFLICT",
    "duplicate_different_role": "SOURCE_ROLE_CARRIER_CONFLICT"
  },
  "x-deeplus-conflict-fixtures": [
    {
      "fixture_id": "SRCROLE-CARRIER-POS-001",
