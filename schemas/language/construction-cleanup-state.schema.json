{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplus-lang.org/schema/r11/construction-cleanup-state.schema.json",
  "title": "Deeplus R11 construction, initialization, and cleanup state contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revision",
    "status",
    "repository",
    "branch",
    "baseline_commit",
    "baseline_tree",
    "gap_id",
    "dependencies",
    "source_surface",
    "identity_domains",
    "session_state_machine",
    "field_slot_state",
    "delegation",
    "prepublication_self",
    "field_initialization_commit",
    "object_commit",
    "construction_abort",
    "admitted_move_interaction",
    "live_object_cleanup",
    "hir_contract",
    "mir_contract",
    "diagnostics",
    "rejected_alternatives",
    "status_fence"
  ],
  "properties": {
    "schema": {"const": "deeplus.construction-cleanup-state/r1"},
    "revision": {"const": "R11-INTEGRATED-R1"},
    "status": {"const": "CURRENT_STABLE_DESIGN_MACHINE_CONTRACT"},
    "repository": {"const": "https://github.com/howork/Deeplus.git"},
    "branch": {"const": "main"},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "baseline_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "gap_id": {"const": "IR-OWN-P0-016"},
    "dependencies": {"type": "object"},
    "source_surface": {"type": "object"},
    "identity_domains": {"type": "array", "minItems": 9, "maxItems": 9},
    "session_state_machine": {"type": "object"},
    "field_slot_state": {"type": "object"},
    "delegation": {"type": "object"},
    "prepublication_self": {"type": "object"},
    "field_initialization_commit": {"type": "object"},
    "object_commit": {"type": "object"},
    "construction_abort": {"type": "object"},
    "admitted_move_interaction": {"type": "object"},
    "live_object_cleanup": {"type": "object"},
    "hir_contract": {"type": "object"},
    "mir_contract": {"type": "object"},
    "diagnostics": {"type": "object"},
    "rejected_alternatives": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true},
    "status_fence": {"type": "object"}
  }
}
