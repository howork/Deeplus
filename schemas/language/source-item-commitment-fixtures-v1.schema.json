{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplus-lang.org/schema/r88/source-item-commitment-fixtures-v1.schema.json",
  "title": "Deeplus source-item commitment fixtures V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "decision_schema", "contract", "evidence_level", "cases", "counts"],
  "properties": {
    "schema": {"const": "deeplus.source-item-commitment-fixtures/v1"},
    "decision_schema": {"const": "schemas/language/source-item-commitment-decision-v1.schema.json"},
    "contract": {"const": "spec/contracts/source-item-commitment-v1.json"},
    "evidence_level": {"const": "E2_DESIGN_STATIC_PRODUCT_NOT_RUN"},
    "cases": {
      "type": "array", "minItems": 14, "maxItems": 14, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "class", "source", "descriptor", "expected"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^R88-SIC-(?:N|B|R)-[0-9]{3}$"},
          "class": {"enum": ["normal", "boundary", "reject"]},
          "source": {"type": "string", "minLength": 1},
          "descriptor": {"$ref": "source-item-commitment-decision-v1.schema.json"},
          "expected": {
            "type": "object", "additionalProperties": false,
            "required": ["outcome", "owner_or_null", "diagnostic_or_null"],
            "properties": {
              "outcome": {"enum": ["COMMIT_DECLARATION", "ROLLBACK_AND_PARSE_STATEMENT", "REJECT"]},
              "owner_or_null": {"type": ["string", "null"]},
              "diagnostic_or_null": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "counts": {"const": {"normal": 5, "boundary": 4, "reject": 5, "total": 14, "executed_product": 0}}
  }
}
