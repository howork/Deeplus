{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplus-lang.invalid/schemas/actor-transport-allocation-v1.schema.json",
  "title": "Deeplus Actor Transport Allocation V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "gap_id", "surface_responsibility", "profiles",
    "transaction", "hir_contract", "mir_contract", "no_go", "governance"
  ],
  "properties": {
    "schema": {"const": "deeplus.actor-transport-allocation/r1"},
    "status": {"const": "LOCAL_STABLE_DESIGN_CANDIDATE_NOT_INTEGRATED"},
    "gap_id": {"const": "IR-ACTOR-P1-060"},
    "surface_responsibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["one_way_value_type", "request_value_type", "throws", "effects", "actor_message_error_cases"],
      "properties": {
        "one_way_value_type": {"const": "Result<Unit, error ActorMessageError>"},
        "request_value_type": {"const": "Result<Reply<T>, error ActorMessageError>"},
        "throws": {"const": ["AllocationError"]},
        "effects": {"const": ["allocate"]},
        "actor_message_error_cases": {"const": ["mailboxFull", "receiverClosedBeforeAdmission", "receiverClosedBeforeReply"]}
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_unbounded_v1", "bounded_reject_v1"],
      "properties": {
        "logical_unbounded_v1": {"const": "NO_LANGUAGE_CAPACITY_REJECTION_FINITE_STORAGE_ALLOCATION_ERROR_VISIBLE"},
        "bounded_reject_v1": {"const": "RECEIVER_CLOSED_THEN_CAPACITY_CHECK_THEN_PRECOMMIT_ALLOCATION"}
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "allocation_stages", "failure", "commit"],
      "properties": {
        "order": {"const": ["STATIC_SELECT", "EVALUATE_OPERANDS", "LOCK_ADMISSION", "CHECK_RECEIVER_OPEN", "CHECK_BOUNDED_CAPACITY", "STAGE_ALL_ALLOCATIONS", "ENQUEUE_COMMIT"]},
        "allocation_stages": {"const": ["ENVELOPE_STORAGE", "MAILBOX_STORAGE_IF_REQUIRED", "REQUEST_RESPONSIBILITY_STORAGE_IF_REQUEST"]},
        "failure": {
          "const": {
            "outcome": "THROW_ALLOCATION_ERROR",
            "owner": "SENDER",
            "reverse_cleanup": true,
            "message_publish_count": 0,
            "channel_sequence_count": 0,
            "reply_id_publish_count": 0,
            "correlation_id_publish_count": 0,
            "ownership_commit_count": 0
          }
        },
        "commit": {
          "const": {
            "atomic": true,
            "message_publish_count": 1,
            "channel_sequence_count": 1,
            "ownership_commit_count": 1,
            "request_identity_publish_count_if_request": 2,
            "postcommit_allocation_count": 0
          }
        }
      }
    },
    "hir_contract": {
      "const": {
        "plan": "ActorTransportAllocationPlanV1",
        "error_set": ["AllocationError"],
        "effect_row": ["allocate"],
        "publish_phase": "ENQUEUE_COMMIT",
        "postcommit_allocation_count": 0
      }
    },
    "mir_contract": {
      "const": {
        "allocation_reject_phase": "allocation_rejected",
        "error_successor": "ERROR",
        "allocation_error": "AllocationError",
        "allocation_effect": "allocate",
        "postcommit_allocation_count": 0
      }
    },
    "no_go": {
      "const": ["ALLOCATION_TO_MAILBOX_FULL", "ALLOCATION_TO_CANCELLATION", "ALLOCATION_TO_DEFECT", "POSTCOMMIT_ALLOCATION", "IMPLICIT_RETRY", "IMPLICIT_BLOCK", "IMPLICIT_SUSPEND", "SILENT_DROP"]
    },
    "governance": {
      "const": {"semantic_p0": 0, "feature_p1": "22_OPEN_UNCHANGED", "product_lanes": "15_OF_15_NOT_RUN", "github_mutation": "NOT_PERFORMED"}
    }
  }
}
