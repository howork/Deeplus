{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplus-lang.org/schema/current/continuation-interface-r1.schema.json",
  "title": "Deeplus continuation interface R1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "gap_id", "interface_identity", "interface_version", "source_surface", "authorities", "canonical_encoding", "bound_artifact_digests", "identity_domains", "frame_states", "epoch_states", "transitions", "place_dispositions", "frame_slot_contract", "loan_fence", "partition_laws", "root_rebind_law", "cleanup_law", "actor_scope_law", "race_and_terminal_law", "projection_entry_maps", "dispatch_entry_law", "seam_status", "component_digests", "digest_material", "continuation_interface_digest", "governance"],
  "properties": {
    "schema": {"const": "deeplus.continuation-interface/r1"},
    "status": {"const": "LOCAL_CANONICAL_PROJECTION_NOT_PUBLISHED"},
    "gap_id": {"const": "IR-OWN-P0-017"},
    "interface_identity": {"const": "ContinuationInterfaceId:DEEPLUS_CONTINUATION_INTERFACE_R1"},
    "interface_version": {"const": 1},
    "source_surface": {"type": "object", "additionalProperties": false, "required": ["new_spelling_count", "grammar_change_required"], "properties": {"new_spelling_count": {"const": 0}, "grammar_change_required": {"const": false}}},
    "authorities": {"type": "object", "additionalProperties": false, "required": ["suspension_frame_contract", "suspension_frame_schema", "continuation_receipt_schema", "hir_schema", "mir_schema", "mir_machine_registry"], "properties": {"suspension_frame_contract": {"const": "spec/contracts/suspension-frame-responsibility-r1.json"}, "suspension_frame_schema": {"const": "schemas/language/suspension-frame-responsibility.schema.json"}, "continuation_receipt_schema": {"const": "schemas/language/continuation-receipt-r1.schema.json"}, "hir_schema": {"const": "schemas/language/canonical-hir-h1.schema.json"}, "mir_schema": {"const": "schemas/language/deeplus-mir.schema.json"}, "mir_machine_registry": {"const": "spec/contracts/mir-machine-registry.json"}}},
    "canonical_encoding": {"type": "object", "additionalProperties": false, "required": ["algorithm", "object_keys", "ordered_arrays", "identity_sets", "self_digest_fields_excluded", "runtime_addresses_excluded"], "properties": {"algorithm": {"const": "DEEPLUS_CANONICAL_JSON_UTF8_SHA256_V1"}, "object_keys": {"const": "UTF8_LEXICOGRAPHIC_ASCENDING"}, "ordered_arrays": {"const": "DECLARED_ORDER_PRESERVED"}, "identity_sets": {"const": "TYPED_ID_ASCENDING_UNIQUE"}, "self_digest_fields_excluded": {"const": true}, "runtime_addresses_excluded": {"const": true}}},
    "bound_artifact_digests": {"type": "object", "minProperties": 5, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "identity_domains": {"type": "object", "additionalProperties": false, "required": ["static", "dynamic", "referenced"], "properties": {"static": {"const": ["ContinuationFramePlanId", "SuspensionPointId", "FrameSlotId"]}, "dynamic": {"const": ["ContinuationFrameId", "SuspensionEpochId", "ContinuationReceiptId"]}, "referenced": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string"}}}},
    "frame_states": {"const": ["RUNNING", "SUSPENDED", "CLEANING", "TERMINAL_COMPLETED", "TERMINAL_FAILED", "TERMINAL_CANCELLED"]},
    "epoch_states": {"const": ["PREPARING", "COMMITTED", "RESUME_WON", "CANCEL_WON", "DISCHARGED"]},
    "transitions": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["operation", "frame_from", "frame_to", "epoch_from", "epoch_to", "winner_witness_or_null", "receipt_effect"], "properties": {"operation": {"enum": ["FRAME_CREATE", "FRAME_SUSPEND_COMMIT", "FRAME_RESUME_COMMIT", "FRAME_CANCEL_COMMIT", "FRAME_CLEANUP_STEP", "FRAME_TERMINATE"]}, "frame_from": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "frame_to": {"enum": ["RUNNING", "SUSPENDED", "CLEANING", "TERMINAL_COMPLETED", "TERMINAL_FAILED", "TERMINAL_CANCELLED"]}, "epoch_from": {"oneOf": [{"enum": ["PREPARING", "COMMITTED", "CANCEL_WON"]}, {"type": "null"}]}, "epoch_to": {"oneOf": [{"enum": ["COMMITTED", "CANCEL_WON", "DISCHARGED"]}, {"type": "null"}]}, "winner_witness_or_null": {"oneOf": [{"enum": ["RESUME_WON", "CANCEL_WON"]}, {"type": "null"}]}, "receipt_effect": {"type": "string"}}}},
    "place_dispositions": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["disposition", "materializes_frame_slot", "owner_count", "admitted_loan_class"], "properties": {"disposition": {"enum": ["NOT_LIVE_AFTER_SUSPEND", "REUSABLE_COPY", "OWNED_TRANSFER", "STATIC_SHARED_BORROW"]}, "materializes_frame_slot": {"type": "boolean"}, "owner_count": {"type": "integer", "minimum": 0, "maximum": 1}, "admitted_loan_class": {"enum": ["NONE", "STATIC_IMMUTABLE_SHARED"]}}}},
    "frame_slot_contract": {"type": "object"},
    "loan_fence": {"type": "object"},
    "partition_laws": {"type": "object"},
    "root_rebind_law": {"type": "object"},
    "cleanup_law": {"type": "object"},
    "actor_scope_law": {"type": "object"},
    "race_and_terminal_law": {"type": "object"},
    "projection_entry_maps": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["target_projection", "entry_kind", "generated_entry", "image_generation_required", "continuation_lease_required", "address_as_identity"], "properties": {"target_projection": {"enum": ["Xvm", "ObjectAot", "InMemoryJit"]}, "entry_kind": {"enum": ["BYTECODE_CONTINUATION_ENTRY", "CRANELIFT_GENERATED_CONTINUATION_ENTRY"]}, "generated_entry": {"type": "boolean"}, "image_generation_required": {"type": "boolean"}, "continuation_lease_required": {"type": "boolean"}, "address_as_identity": {"const": false}}}},
    "dispatch_entry_law": {"type": "object"},
    "seam_status": {"type": "object"},
    "component_digests": {"type": "object", "minProperties": 5, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "digest_material": {"type": "object", "minProperties": 10},
    "continuation_interface_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "governance": {"type": "object", "additionalProperties": false, "required": ["semantic_p0_delta", "gap_status", "canonical_feature_p1", "m13_actions", "product_lanes", "production_execution", "github_publication"], "properties": {"semantic_p0_delta": {"const": 0}, "gap_status": {"const": "APPROVED_NOT_INTEGRATED"}, "canonical_feature_p1": {"const": "22_OPEN_UNCHANGED"}, "m13_actions": {"const": "4_OPEN_UNCHANGED"}, "product_lanes": {"const": "15_OF_15_NOT_RUN"}, "production_execution": {"const": "NOT_RUN"}, "github_publication": {"const": "SUSPENDED"}}}
  }
}
