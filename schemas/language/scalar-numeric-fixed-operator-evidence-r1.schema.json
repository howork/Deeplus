{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplus-lang.org/schema/current/scalar-numeric-fixed-operator-evidence-r1.schema.json",
  "title": "Deeplus R54 scalar numeric and fixed-operator evidence overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "revision",
    "canonical_baseline_commit",
    "local_predecessor_commit",
    "candidate_status",
    "feature_ids",
    "evidence_entries",
    "bindings",
    "acceptance_cases",
    "counts",
    "guards"
  ],
  "properties": {
    "$schema": {
      "const": "../../../schemas/language/scalar-numeric-fixed-operator-evidence-r1.schema.json"
    },
    "schema": {
      "const": "deeplus.scalar-numeric-fixed-operator-evidence/r1"
    },
    "revision": {
      "const": "r54-local-scalar-numeric-fixed-operator-trace-closure-r1"
    },
    "canonical_baseline_commit": {
      "const": "39a5d50cc770341c4b9776d00d84520b780d0c62"
    },
    "local_predecessor_commit": {
      "const": "7f540c2c593911ec19003b43ff48652615becfc6"
    },
    "candidate_status": {
      "const": "NONCANONICAL_DESIGN_STATIC_EVIDENCE_OVERLAY"
    },
    "feature_ids": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "evidence_entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "acceptance_cases": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_count",
        "evidence_entry_count",
        "binding_count",
        "predecessor_blocked_cell_count",
        "bound_direct_transition_count",
        "bound_delegated_transition_count",
        "not_applicable_transition_count",
        "predecessor_total_blocked_cell_count",
        "post_overlay_total_blocked_cell_count",
        "acceptance_case_count"
      ],
      "properties": {
        "feature_count": {
          "const": 14
        },
        "evidence_entry_count": {
          "type": "integer",
          "minimum": 1
        },
        "binding_count": {
          "const": 40
        },
        "predecessor_blocked_cell_count": {
          "const": 40
        },
        "bound_direct_transition_count": {
          "const": 36
        },
        "bound_delegated_transition_count": {
          "const": 1
        },
        "not_applicable_transition_count": {
          "const": 3
        },
        "predecessor_total_blocked_cell_count": {
          "const": 1381
        },
        "post_overlay_total_blocked_cell_count": {
          "const": 1341
        },
        "acceptance_case_count": {
          "const": 27
        }
      }
    },
    "guards": {
      "type": "object"
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_key",
        "class",
        "path",
        "locator_kind",
        "locator",
        "stage_role"
      ],
      "properties": {
        "evidence_key": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "enum": [
            "ARTIFACT_POINTER",
            "CHECKER_PREDICATE_ID",
            "CONTRACT_RULE_ID",
            "DIAGNOSTIC_REGISTRY_ID",
            "FIXTURE_CASE_ID",
            "MIR_RULE_ID",
            "TEACHING_EXAMPLE_ID",
            "TRACE_ACCEPTANCE_CASE_ID"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "locator_kind": {
          "enum": [
            "FILE",
            "JSON_POINTER",
            "REGISTRY_ID"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "stage_role": {
          "enum": [
            "AST_FRONTEND",
            "STATIC_SEMANTICS",
            "DYNAMIC_LOWERING",
            "CONFORMANCE_TESTS:POSITIVE",
            "CONFORMANCE_TESTS:BOUNDARY",
            "CONFORMANCE_TESTS:REJECT"
          ]
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_id",
        "stage",
        "outcome",
        "disposition",
        "evidence_keys",
        "delegate_feature_id",
        "not_applicable"
      ],
      "properties": {
        "feature_id": {
          "type": "string"
        },
        "stage": {
          "enum": [
            "AST_FRONTEND",
            "STATIC_SEMANTICS",
            "DYNAMIC_LOWERING",
            "CONFORMANCE_TESTS"
          ]
        },
        "outcome": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "POSITIVE",
            "BOUNDARY",
            "REJECT",
            null
          ]
        },
        "disposition": {
          "enum": [
            "BOUND_DIRECT",
            "BOUND_DELEGATED",
            "NOT_APPLICABLE"
          ]
        },
        "evidence_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "delegate_feature_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "not_applicable": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "feature_id",
        "outcome",
        "source_or_subject",
        "expected",
        "diagnostic_or_null",
        "assertions",
        "execution_state"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^R54-NUM-[0-9]{3}$"
        },
        "feature_id": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "POSITIVE",
            "BOUNDARY",
            "REJECT"
          ]
        },
        "source_or_subject": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "diagnostic_or_null": {
          "type": [
            "string",
            "null"
          ]
        },
        "assertions": {
          "type": "object",
          "minProperties": 1
        },
        "execution_state": {
          "const": "DESIGN_STATIC_NOT_RUN"
        }
      }
    }
  }
}
