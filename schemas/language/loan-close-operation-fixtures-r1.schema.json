{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplus-lang.org/schema/r34/loan-close-operation-fixtures-r1.schema.json",
  "title": "Deeplus R34 path-sensitive loan-close fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract",
    "revision",
    "status",
    "cases",
    "mutation_cases",
    "expected_counts",
    "status_fence"
  ],
  "properties": {
    "schema": {"const": "deeplus.loan-close-operation-fixtures/r1"},
    "contract": {"const": "spec/contracts/loan-close-operation-r1.json"},
    "revision": {"const": "R34-LOAN-CLOSE-OPERATION-R1"},
    "status": {"const": "DESIGN_STATIC_NOT_RUN"},
    "cases": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/case"}
    },
    "mutation_cases": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/mutation"}
    },
    "expected_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "POSITIVE", "BOUNDARY", "NEGATIVE", "MUTATION"],
      "properties": {
        "total": {"const": 12},
        "POSITIVE": {"const": 3},
        "BOUNDARY": {"const": 3},
        "NEGATIVE": {"const": 6},
        "MUTATION": {"const": 12}
      }
    },
    "status_fence": {"type": "object"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "kind"],
      "properties": {
        "event_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["BEGIN_SHARED", "BEGIN_EXCLUSIVE", "BEGIN_REBORROW", "USE", "END", "OWNER_MOVE", "OWNER_CLEANUP", "SUSPEND", "JOIN", "PRIMARY_ERROR", "PRIMARY_DEFECT", "PRIMARY_CANCELLATION", "CLEANUP_FAIL", "TERMINAL"]},
        "loan_id_or_null": {"type": ["string", "null"]},
        "parent_loan_id_or_null": {"type": ["string", "null"]},
        "access_token_id_or_null": {"type": ["string", "null"]},
        "overlapping_loan_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "join_id_or_null": {"type": ["string", "null"]},
        "failure_id_or_null": {"type": ["string", "null"]},
        "cleanup_acquisition_ordinal_or_null": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_id", "events"],
      "properties": {
        "path_id": {"$ref": "#/$defs/id"},
        "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}}
      }
    },
    "loan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loan_id", "kind", "region_id", "parent_loan_id_or_null", "begin_operation_id", "end_operation_ids", "access_token_id"],
      "properties": {
        "loan_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["SHARED", "EXCLUSIVE"]},
        "region_id": {"$ref": "#/$defs/id"},
        "parent_loan_id_or_null": {"type": ["string", "null"]},
        "begin_operation_id": {"$ref": "#/$defs/id"},
        "end_operation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "access_token_id": {"$ref": "#/$defs/id"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body_id", "loans", "paths", "suspension_admitted_loan_ids"],
      "properties": {
        "body_id": {"$ref": "#/$defs/id"},
        "loans": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/loan"}},
        "paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path"}},
        "suspension_admitted_loan_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "diagnostic_or_null", "reason_or_null", "primary_failure_or_null", "suppressed_failures"],
      "properties": {
        "verdict": {"enum": ["ACCEPT", "REJECT"]},
        "diagnostic_or_null": {"type": ["string", "null"]},
        "reason_or_null": {"type": ["string", "null"]},
        "primary_failure_or_null": {"type": ["string", "null"]},
        "suppressed_failures": {"type": "array", "items": {"$ref": "#/$defs/id"}}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "class", "scenario", "input", "expected", "product_support"],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "class": {"enum": ["POSITIVE", "BOUNDARY", "NEGATIVE"]},
        "scenario": {"type": "string", "minLength": 1},
        "input": {"$ref": "#/$defs/input"},
        "expected": {"$ref": "#/$defs/expected"},
        "product_support": {"const": "NOT_RUN"}
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutation_id", "base_case_id", "mutation", "expected_diagnostic", "expected_reason", "product_support"],
      "properties": {
        "mutation_id": {"$ref": "#/$defs/id"},
        "base_case_id": {"const": "R34-LOAN-POS-001"},
        "mutation": {"$ref": "#/$defs/id"},
        "expected_diagnostic": {"const": "MIR_LOAN_UNBALANCED"},
        "expected_reason": {"$ref": "#/$defs/id"},
        "product_support": {"const": "NOT_RUN"}
      }
    }
  },
  "x-product-compiler": "NOT_RUN"
}
