{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplus-lang.org/schema/r51f3/diagnostic-dispatch-closure-input-r1.schema.json",
  "title": "DiagnosticDispatchClosureInputR1",
  "oneOf": [
    {
      "$ref": "#/$defs/associatedRequirementInput"
    },
    {
      "$ref": "#/$defs/effectErrorRowPolymorphismInput"
    },
    {
      "$ref": "#/$defs/effectRowSubsumptionInput"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "idArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "nullableId": {
      "oneOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "name",
        "kind",
        "normalized_bounds",
        "default_state",
        "source_order_key",
        "normalized_value_type_or_null",
        "normalized_callable_signature_or_null",
        "normalized_dependency_requirement_ids"
      ],
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "type",
            "value",
            "function"
          ]
        },
        "normalized_bounds": {
          "$ref": "#/$defs/idArray"
        },
        "default_state": {
          "enum": [
            "absent",
            "present"
          ]
        },
        "source_order_key": {
          "$ref": "#/$defs/id"
        },
        "normalized_value_type_or_null": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "normalized_callable_signature_or_null": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "normalized_dependency_requirement_ids": {
          "$ref": "#/$defs/idArray"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "requirement_id",
        "kind",
        "origin",
        "witness_id_or_null",
        "implementation_id_or_null",
        "normalized_binding_id",
        "satisfied_bounds",
        "source_order_key",
        "normalized_value_type_or_null",
        "normalized_callable_signature_or_null"
      ],
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/id"
        },
        "requirement_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "type",
            "value",
            "function"
          ]
        },
        "origin": {
          "enum": [
            "explicit",
            "canonical_inherited"
          ]
        },
        "witness_id_or_null": {
          "$ref": "#/$defs/nullableId"
        },
        "implementation_id_or_null": {
          "$ref": "#/$defs/nullableId"
        },
        "normalized_binding_id": {
          "$ref": "#/$defs/id"
        },
        "satisfied_bounds": {
          "$ref": "#/$defs/idArray"
        },
        "source_order_key": {
          "$ref": "#/$defs/id"
        },
        "normalized_value_type_or_null": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "normalized_callable_signature_or_null": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "obligationEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_requirement_id",
        "to_requirement_id"
      ],
      "properties": {
        "from_requirement_id": {
          "$ref": "#/$defs/id"
        },
        "to_requirement_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "associatedRequirementInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "predicate_id",
        "evaluation_context",
        "trait_id",
        "owner_type_id_or_null",
        "conformance_id_or_null",
        "selected_requirement_id",
        "requirements",
        "bindings"
      ],
      "properties": {
        "schema": {
          "const": "deeplus.associated-requirement-decision-input/r1"
        },
        "predicate_id": {
          "const": "AssociatedRequirementAdmitted"
        },
        "evaluation_context": {
          "enum": [
            "declaration",
            "binding"
          ]
        },
        "trait_id": {
          "$ref": "#/$defs/id"
        },
        "owner_type_id_or_null": {
          "$ref": "#/$defs/nullableId"
        },
        "conformance_id_or_null": {
          "$ref": "#/$defs/nullableId"
        },
        "selected_requirement_id": {
          "$ref": "#/$defs/id"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/binding"
          }
        }
      }
    },
    "rowAtom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "normalized_parameter_ids",
        "visibility"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/id"
        },
        "normalized_parameter_ids": {
          "$ref": "#/$defs/idArray"
        },
        "visibility": {
          "enum": [
            "private",
            "common",
            "public"
          ]
        }
      }
    },
    "rowExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_kind",
        "atoms",
        "variable_ids"
      ],
      "properties": {
        "row_kind": {
          "enum": [
            "effect",
            "error"
          ]
        },
        "atoms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/rowAtom"
          }
        },
        "variable_ids": {
          "$ref": "#/$defs/idArray"
        }
      }
    },
    "quantifiedRowParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_id",
        "row_kind",
        "source_order_key",
        "scope"
      ],
      "properties": {
        "parameter_id": {
          "$ref": "#/$defs/id"
        },
        "row_kind": {
          "enum": [
            "effect",
            "error"
          ]
        },
        "source_order_key": {
          "$ref": "#/$defs/id"
        },
        "scope": {
          "enum": [
            "declared_generic",
            "solver_local"
          ]
        }
      }
    },
    "rowConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "left_row_expression",
        "relation",
        "right_row_expression",
        "canonical_order_key"
      ],
      "properties": {
        "constraint_id": {
          "$ref": "#/$defs/id"
        },
        "left_row_expression": {
          "$ref": "#/$defs/rowExpression"
        },
        "relation": {
          "enum": [
            "subset",
            "equal"
          ]
        },
        "right_row_expression": {
          "$ref": "#/$defs/rowExpression"
        },
        "canonical_order_key": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "substitutionEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_parameter_id",
        "to_parameter_id"
      ],
      "properties": {
        "from_parameter_id": {
          "$ref": "#/$defs/id"
        },
        "to_parameter_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "effectErrorRowPolymorphismInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "predicate_id",
        "quantified_row_parameters",
        "row_constraints",
        "declaration_visibility",
        "exported_parameter_ids"
      ],
      "properties": {
        "schema": {
          "const": "deeplus.effect-error-row-polymorphism-decision-input/r1"
        },
        "predicate_id": {
          "const": "EffectErrorRowPolymorphismAdmitted"
        },
        "quantified_row_parameters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/quantifiedRowParameter"
          }
        },
        "row_constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/rowConstraint"
          }
        },
        "declaration_visibility": {
          "enum": [
            "private",
            "common",
            "public"
          ]
        },
        "exported_parameter_ids": {
          "$ref": "#/$defs/idArray"
        }
      }
    },
    "effectAtom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_id",
        "parameter_arguments"
      ],
      "properties": {
        "effect_id": {
          "$ref": "#/$defs/id"
        },
        "parameter_arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effectParameterArgument"
          }
        }
      }
    },
    "effectRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atoms",
        "variable_ids"
      ],
      "properties": {
        "atoms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/effectAtom"
          }
        },
        "variable_ids": {
          "$ref": "#/$defs/idArray"
        }
      }
    },
    "rowEnvironmentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variable_id",
        "bound_row"
      ],
      "properties": {
        "variable_id": {
          "$ref": "#/$defs/id"
        },
        "bound_row": {
          "$ref": "#/$defs/effectRow"
        }
      }
    },
    "parameterEnvironmentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_id",
        "parameter_kind",
        "canonical_identity_or_null",
        "alias_parameter_id_or_null"
      ],
      "properties": {
        "parameter_id": {
          "$ref": "#/$defs/id"
        },
        "parameter_kind": {
          "enum": [
            "type_argument",
            "value_argument",
            "effect_argument"
          ]
        },
        "canonical_identity_or_null": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "alias_parameter_id_or_null": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "effectRowSubsumptionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "predicate_id",
        "context_kind",
        "required_row",
        "implementation_row",
        "row_environment",
        "parameter_environment"
      ],
      "properties": {
        "schema": {
          "const": "deeplus.effect-row-subsumption-decision-input/r1"
        },
        "predicate_id": {
          "const": "EffectRowSubsumes"
        },
        "context_kind": {
          "enum": [
            "trait_witness",
            "class_override",
            "function_value"
          ]
        },
        "required_row": {
          "$ref": "#/$defs/effectRow"
        },
        "implementation_row": {
          "$ref": "#/$defs/effectRow"
        },
        "row_environment": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/rowEnvironmentBinding"
          }
        },
        "parameter_environment": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/parameterEnvironmentBinding"
          }
        }
      }
    },
    "effectParameterArgument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_id",
        "expected_kind"
      ],
      "properties": {
        "parameter_id": {
          "$ref": "#/$defs/id"
        },
        "expected_kind": {
          "enum": [
            "type_argument",
            "value_argument",
            "effect_argument"
          ]
        }
      }
    }
  }
}
