{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplus.dev/schemas/language/refinement-r0-formula-v1.schema.json",
  "title": "Deeplus RefinementR0FormulaV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "parameter_type_ids", "formula", "formula_digest"],
  "properties": {
    "schema": {"const": "deeplus.refinement-r0-formula/v1"},
    "parameter_type_ids": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/id"}
    },
    "formula": {"$ref": "#/$defs/formula"},
    "formula_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signed_decimal": {"type": "string", "pattern": "^(0|-?[1-9][0-9]*)$"},
    "unsigned_decimal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "static_value": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {"kind": {"const": "BOOL"}, "value": {"type": "boolean"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "decimal"],
          "properties": {"kind": {"enum": ["SIGNED_INTEGER", "STATIC_INT"]}, "decimal": {"$ref": "#/$defs/signed_decimal"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "decimal"],
          "properties": {"kind": {"const": "UNSIGNED_INTEGER"}, "decimal": {"$ref": "#/$defs/unsigned_decimal"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "bits"],
          "properties": {"kind": {"const": "FLOAT32"}, "bits": {"type": "string", "pattern": "^[0-9a-f]{8}$"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "bits"],
          "properties": {"kind": {"const": "FLOAT64"}, "bits": {"type": "string", "pattern": "^[0-9a-f]{16}$"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "numerator", "denominator"],
          "properties": {
            "kind": {"const": "RATIONAL"},
            "numerator": {"$ref": "#/$defs/signed_decimal"},
            "denominator": {"type": "string", "pattern": "^[1-9][0-9]*$"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "scalar"],
          "properties": {"kind": {"const": "CHAR_SCALAR"}, "scalar": {"type": "string", "pattern": "^U\\+[0-9A-F]{4,6}$"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "enum_type_id", "variant_id", "ordinal"],
          "properties": {
            "kind": {"const": "ORDERED_ENUM"},
            "enum_type_id": {"$ref": "#/$defs/id"},
            "variant_id": {"$ref": "#/$defs/id"},
            "ordinal": {"$ref": "#/$defs/unsigned_decimal"}
          }
        }
      ]
    },
    "term": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "type_id", "parameter_index"],
          "properties": {
            "kind": {"const": "PARAMETER"},
            "type_id": {"$ref": "#/$defs/id"},
            "parameter_index": {"type": "integer", "minimum": 0, "maximum": 31}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "type_id", "place_id"],
          "properties": {
            "kind": {"const": "PLACE"},
            "type_id": {"$ref": "#/$defs/id"},
            "place_id": {"$ref": "#/$defs/id"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "type_id", "value"],
          "properties": {
            "kind": {"const": "STATIC_VALUE"},
            "type_id": {"$ref": "#/$defs/id"},
            "value": {"$ref": "#/$defs/static_value"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "type_id", "intrinsic_id", "arguments"],
          "properties": {
            "kind": {"const": "INTRINSIC"},
            "type_id": {"$ref": "#/$defs/id"},
            "intrinsic_id": {"enum": ["STRING_SCALAR_LENGTH", "BYTES_LENGTH", "LIST_LENGTH", "READONLY_VIEW_LENGTH"]},
            "arguments": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/term"}}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "type_id", "operator", "operand"],
          "properties": {
            "kind": {"const": "UNARY"},
            "type_id": {"$ref": "#/$defs/id"},
            "operator": {"enum": ["PLUS", "MINUS"]},
            "operand": {"$ref": "#/$defs/term"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "type_id", "operator", "left", "right"],
          "properties": {
            "kind": {"const": "BINARY"},
            "type_id": {"$ref": "#/$defs/id"},
            "operator": {"enum": ["ADD", "SUBTRACT", "MULTIPLY", "DIVIDE", "REMAINDER"]},
            "left": {"$ref": "#/$defs/term"},
            "right": {"$ref": "#/$defs/term"}
          }
        }
      ]
    },
    "atom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "operator", "left", "right"],
      "properties": {
        "kind": {"const": "COMPARE"},
        "operator": {"enum": ["EQ", "NE", "LT", "LE", "GT", "GE"]},
        "left": {"$ref": "#/$defs/term"},
        "right": {"$ref": "#/$defs/term"}
      }
    },
    "formula": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind"], "properties": {"kind": {"enum": ["TRUE", "FALSE"]}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "atom"],
          "properties": {"kind": {"const": "ATOM"}, "atom": {"$ref": "#/$defs/atom"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "atom"],
          "properties": {"kind": {"const": "NOT"}, "atom": {"$ref": "#/$defs/atom"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "terms"],
          "properties": {
            "kind": {"enum": ["ALL", "ANY"]},
            "terms": {"type": "array", "minItems": 2, "maxItems": 64, "items": {"$ref": "#/$defs/formula"}}
          }
        }
      ]
    }
  }
}
