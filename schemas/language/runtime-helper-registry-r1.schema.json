{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplus-lang.org/schema/r37/runtime-helper-registry-r1.schema.json",
  "title": "Deeplus runtime helper registry R1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "revision", "runtime_abi_id", "managed_reference_profile_digest_or_null",
    "continuation_interface_digest_or_null", "helper_rows", "conditional_extension_rows",
    "expected_counts", "digest_material", "helper_allowlist_digest", "registry_digest"
  ],
  "properties": {
    "schema": {"const": "deeplus.runtime-helper-registry/r1"},
    "revision": {"const": 1},
    "runtime_abi_id": {"type": "string", "pattern": "^RuntimeAbiId:[A-Za-z0-9_.:/-]+$"},
    "managed_reference_profile_digest_or_null": {"$ref": "#/$defs/nullableSha256"},
    "continuation_interface_digest_or_null": {"$ref": "#/$defs/nullableSha256"},
    "helper_rows": {"type": "array", "minItems": 22, "maxItems": 22, "items": {"$ref": "#/$defs/helperRow"}},
    "conditional_extension_rows": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/conditionalRow"}},
    "expected_counts": {"type": "object", "minProperties": 4},
    "digest_material": {"type": "object", "minProperties": 1},
    "helper_allowlist_digest": {"$ref": "#/$defs/sha256"},
    "registry_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "helperId": {"type": "string", "pattern": "^RuntimeHelperId:[A-Za-z0-9_.:/-]+$"},
    "signatureId": {"type": "string", "pattern": "^RuntimeHelperSignatureId:[A-Za-z0-9_.:/-]+$"},
    "recordId": {"type": "string", "pattern": "^RuntimeAbiRecordId:[A-Za-z0-9_.:/-]+$"},
    "parameterMode": {"enum": ["COPY_VALUE", "CONSUME_ON_ENTRY", "BORROW_READ_CALL_BOUND", "INOUT_EXCLUSIVE_CALL_BOUND", "OPAQUE_HANDLE"]},
    "outcome": {"enum": ["NORMAL", "ERROR", "DEFECT", "CANCELLATION"]},
    "valueKind": {"enum": ["UNIT", "BOOL", "I8", "I16", "I32", "I64", "I128", "U8", "U16", "U32", "U64", "U128", "ISIZE", "USIZE", "F32", "F64", "MANAGED_HANDLE", "AGGREGATE_SLOT", "TYPE_ID", "OPAQUE_RUNTIME_TOKEN"]},
    "helperRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_helper_id", "runtime_helper_signature_id", "helper_version",
        "terminator_kind", "operation", "arguments_record_id", "result_record_id",
        "parameter_modes", "normal_result_kind", "admitted_outcomes", "completion_modes",
        "may_block", "may_collect", "may_suspend", "observes_cancellation", "projection_phase_or_null",
        "parameter_address_classes", "managed_referent_or_interior_address_cross_boundary",
        "ownership_profile_digest", "managed_reference_profile_digest_or_null",
        "continuation_interface_digest_or_null", "signature_digest"
      ],
      "properties": {
        "runtime_helper_id": {"$ref": "#/$defs/helperId"},
        "runtime_helper_signature_id": {"$ref": "#/$defs/signatureId"},
        "helper_version": {"const": 1},
        "terminator_kind": {"enum": ["CANCEL_CHECK", "SUSPEND", "RUN_OP", "ACTOR_OP", "PROVIDER_OP", "ONCE_OP", "SYNC_OP", "INVOKE", "TARGET_PROJECTION_STEP"]},
        "projection_phase_or_null": {
          "oneOf": [
            {"enum": ["BEFORE_MAY_COLLECT_ENTRY", "AFTER_OUTCOME_COMMIT"]},
            {"type": "null"}
          ]
        },
        "operation": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "arguments_record_id": {"$ref": "#/$defs/recordId"},
        "result_record_id": {"$ref": "#/$defs/recordId"},
        "parameter_modes": {"type": "array", "items": {"$ref": "#/$defs/parameterMode"}},
        "parameter_address_classes": {
          "type": "array",
          "items": {"enum": ["NON_ADDRESS_VALUE", "OPAQUE_MANAGED_HANDLE", "CALL_BOUNDED_ADDRESS"]}
        },
        "managed_referent_or_interior_address_cross_boundary": {"const": false},
        "normal_result_kind": {"$ref": "#/$defs/valueKind"},
        "admitted_outcomes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/outcome"}},
        "completion_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["COMPLETE", "PARKED"]}},
        "may_block": {"type": "boolean"},
        "may_collect": {"type": "boolean"},
        "may_suspend": {"type": "boolean"},
        "observes_cancellation": {"type": "boolean"},
        "ownership_profile_digest": {"$ref": "#/$defs/sha256"},
        "managed_reference_profile_digest_or_null": {"$ref": "#/$defs/nullableSha256"},
        "continuation_interface_digest_or_null": {"$ref": "#/$defs/nullableSha256"},
        "signature_digest": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"terminator_kind": {"const": "TARGET_PROJECTION_STEP"}}, "required": ["terminator_kind"]},
          "then": {"properties": {"projection_phase_or_null": {"enum": ["BEFORE_MAY_COLLECT_ENTRY", "AFTER_OUTCOME_COMMIT"]}}},
          "else": {"properties": {"projection_phase_or_null": {"type": "null"}}}
        }
      ]
    },
    "conditionalRow": {"$ref": "#/$defs/helperRow"}
  }
}
