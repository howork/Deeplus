{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplus-lang.org/schema/current/lexical-trivia-source-root-evidence-r1.schema.json",
  "title": "Deeplus R55 lexical trivia and source-root trace overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema", "revision", "canonical_baseline_commit",
    "local_predecessor_commit", "candidate_status", "feature_ids",
    "evidence_entries", "bindings", "acceptance_cases", "counts", "guards"
  ],
  "properties": {
    "$schema": {"const": "../../../schemas/language/lexical-trivia-source-root-evidence-r1.schema.json"},
    "schema": {"const": "deeplus.lexical-trivia-source-root-evidence/r1"},
    "revision": {"const": "r55-local-lexical-trivia-source-root-closure-r1"},
    "canonical_baseline_commit": {"const": "39a5d50cc770341c4b9776d00d84520b780d0c62"},
    "local_predecessor_commit": {"const": "89ded1ab5c9110476f7043e5f44b71ddd72d19a1"},
    "candidate_status": {"const": "NONCANONICAL_DESIGN_STATIC_EVIDENCE_OVERLAY"},
    "feature_ids": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"type": "string"}},
    "evidence_entries": {"type": "array", "minItems": 38, "maxItems": 38, "items": {"$ref": "#/$defs/evidence"}},
    "bindings": {"type": "array", "minItems": 38, "maxItems": 38, "items": {"$ref": "#/$defs/binding"}},
    "acceptance_cases": {"type": "array", "minItems": 18, "maxItems": 18, "items": {"type": "object"}},
    "counts": {"type": "object"},
    "guards": {"type": "object"}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_key", "class", "path", "locator_kind", "locator", "stage_role"],
      "properties": {
        "evidence_key": {"type": "string", "minLength": 1},
        "class": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "locator_kind": {"enum": ["FILE", "JSON_POINTER", "REGISTRY_ID"]},
        "locator": {"type": "string", "minLength": 1},
        "stage_role": {"type": "string", "minLength": 1}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "stage", "outcome", "disposition", "evidence_keys", "delegate_feature_id", "not_applicable"],
      "properties": {
        "feature_id": {"type": "string"},
        "stage": {"type": "string"},
        "outcome": {"type": ["string", "null"]},
        "disposition": {"enum": ["BOUND_DIRECT", "BOUND_DELEGATED", "NOT_APPLICABLE"]},
        "evidence_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "delegate_feature_id": {"type": ["string", "null"]},
        "not_applicable": {"type": ["object", "null"]}
      }
    }
  }
}
