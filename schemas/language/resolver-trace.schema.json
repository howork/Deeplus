                {"$ref": "#/$defs/passStageStatus"},
                {"$ref": "#/$defs/passStageStatus"},
                {"$ref": "#/$defs/passStageStatus"},
                {"$ref": "#/$defs/passStageStatus"},
                {"$ref": "#/$defs/passStageStatus"},
                {"$ref": "#/$defs/passStageStatus"},
                {"$ref": "#/$defs/passStageStatus"},
                {"$ref": "#/$defs/failStageStatus"}
              ]
            },
            "result": {
              "allOf": [
                {"$ref": "#/$defs/rejectedResult"},
                {
                  "properties": {
                    "rejection_reason": {
                      "enum": [
                        "MISSING_EXPORT_EDGE",
                        "INTERFACE_DIGEST_MISMATCH"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "acceptedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "resolved_identity",
        "selected_count",
        "rejection_reason_or_null"
      ],
      "properties": {
        "kind": {
          "const": "RESOLVED_NONCALL_REFERENCE"
        },
        "resolved_identity": {
          "$ref": "#/$defs/resolvedIdentity"
        },
        "selected_count": {
          "const": 1
        },
        "rejection_reason_or_null": {
          "type": "null"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resolved_identity": {
                "pattern": "^ModuleId:"
              }
            }
          },
          "then": {
            "properties": {
              "resolved_identity": {
                "pattern": "^ModuleId:[^\\s]+$"
              }
            }
          }
        }
      ]
    },
    "rejectedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "resolved_ref_or_null",
        "selected_count",
        "rejection_reason"
      ],
      "properties": {
        "kind": {
          "const": "REJECTED"
        },
        "resolved_ref_or_null": {
          "type": "null"
        },
        "selected_count": {
          "const": 0
        },
        "rejection_reason": {
          "$ref": "#/$defs/rejectionReason"
        }
      }
    },
    "deferredOverloadResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "analysis_hir_overload_set_ref",
        "canonical_hir_projection",
        "winner_selected"
      ],
      "properties": {
        "kind": {
          "const": "RESOLVED_OVERLOAD_SET_REF_IN_ANALYSIS_HIR"
        },
        "analysis_hir_overload_set_ref": {
          "$ref": "#/$defs/analysisHirOverloadSetRef"
        },
        "canonical_hir_projection": {
          "const": false
        },
        "winner_selected": {
          "const": false
        }
      }
    },
    "diagnosticSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "winner_source_origin_id_or_null",
        "winner_rejection_reason_or_null",
        "suppressed_source_origin_ids"
      ],
      "properties": {
        "winner_source_origin_id_or_null": {
          "oneOf": [
            {
              "$ref": "#/$defs/sourceOriginId"
            },
            {
              "type": "null"
            }
          ]
        },
        "winner_rejection_reason_or_null": {
          "oneOf": [
            {
              "$ref": "#/$defs/rejectionReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "suppressed_source_origin_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceOriginId"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "winner_source_origin_id_or_null": {
              "type": "null"
            },
            "winner_rejection_reason_or_null": {
              "type": "null"
            },
            "suppressed_source_origin_ids": {
              "maxItems": 0
            }
          }
        },
        {
          "properties": {
            "winner_source_origin_id_or_null": {
              "$ref": "#/$defs/sourceOriginId"
            },
            "winner_rejection_reason_or_null": {
              "$ref": "#/$defs/rejectionReason"
            }
          }
        }
      ]
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seal_status",
        "counters"
      ],
      "properties": {
        "seal_status": {
          "enum": [
            "SEALED",
            "REJECTED_AT_HIR_SEAL",
            "NOT_EVALUATED"
          ]
        },
        "counters": {
          "$ref": "#/$defs/sealCounters"
        }
      },
      "oneOf": [
        {
          "properties": {
            "seal_status": {
              "const": "SEALED"
            },
            "counters": {
              "$ref": "#/$defs/zeroSealCounters"
            }
          }
        },
        {
          "properties": {
            "seal_status": {
              "const": "REJECTED_AT_HIR_SEAL"
            },
            "counters": {
              "$ref": "#/$defs/rejectedSealCounters"
            }
          }
        },
        {
          "properties": {
            "seal_status": {
              "const": "NOT_EVALUATED"
            },
            "counters": {
              "$ref": "#/$defs/notEvaluatedSealCounters"
            }
          }
        }
      ]
    },
    "sealCounters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unbound_primary_count",
        "unresolved_count",
        "candidate_set_count",
        "missing_typed_id_count",
        "missing_visibility_proof_count",
        "recovery_binding_count",
        "runtime_relookup_count",
        "overload_winner_count",
        "canonical_hir_overload_set_ref_count"
      ],
      "properties": {
        "unbound_primary_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unresolved_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "candidate_set_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "missing_typed_id_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "missing_visibility_proof_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "recovery_binding_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "runtime_relookup_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "overload_winner_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "canonical_hir_overload_set_ref_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "zeroSealCounters": {
      "allOf": [
        {
          "$ref": "#/$defs/sealCounters"
        },
        {
          "properties": {
            "unbound_primary_count": {
              "const": 0
            },
            "unresolved_count": {
              "const": 0
            },
            "candidate_set_count": {
              "const": 0
            },
            "missing_typed_id_count": {
              "const": 0
            },
            "missing_visibility_proof_count": {
              "const": 0
            },
            "recovery_binding_count": {
              "const": 0
            },
            "runtime_relookup_count": {
              "const": 0
            },
            "overload_winner_count": {
              "const": 0
            },
            "canonical_hir_overload_set_ref_count": {
              "const": 0
            }
          }
        }
      ]
    },
    "rejectedSealCounters": {
      "allOf": [
        {
          "$ref": "#/$defs/sealCounters"
        },
        {
          "properties": {
            "recovery_binding_count": {
              "const": 0
            },
            "overload_winner_count": {
              "const": 0
            },
            "canonical_hir_overload_set_ref_count": {
              "const": 0
            }
          },
          "anyOf": [
            {
              "properties": {
                "unbound_primary_count": {
                  "minimum": 1
                }
              }
            },
            {
              "properties": {
                "unresolved_count": {
                  "minimum": 1
                }
              }
            },
            {
              "properties": {
                "candidate_set_count": {
                  "minimum": 1
                }
              }
            },
            {
              "properties": {
                "missing_typed_id_count": {
                  "minimum": 1
                }
              }
            },
            {
              "properties": {
                "missing_visibility_proof_count": {
                  "minimum": 1
                }
              }
            },
            {
              "properties": {
                "runtime_relookup_count": {
                  "minimum": 1
                }
              }
            }
          ]
        }
      ]
    },
    "notEvaluatedSealCounters": {
      "allOf": [
        {
          "$ref": "#/$defs/sealCounters"
        },
        {
          "properties": {
            "unbound_primary_count": {
              "type": "null"
            },
            "unresolved_count": {
              "type": "null"
            },
            "candidate_set_count": {
              "type": "null"
            },
            "missing_typed_id_count": {
              "type": "null"
            },
            "missing_visibility_proof_count": {
              "type": "null"
            },
            "recovery_binding_count": {
              "type": "null"
            },
            "runtime_relookup_count": {
