{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplus-lang.org/schema/current/implementation-target-global-trace-evidence-r1.schema.json",
  "title": "Deeplus R76 global implementation-target trace evidence overlay",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "revision", "canonical_baseline_commit", "local_predecessor_commit", "candidate_status", "feature_ids", "evidence_entries", "bindings", "counts", "guards"],
  "properties": {
    "$schema": {"const": "../../../schemas/language/implementation-target-global-trace-evidence-r1.schema.json"},
    "schema": {"const": "deeplus.implementation-target-global-trace-evidence/r1"},
    "revision": {"const": "r76-global-implementation-target-trace-closure-r1"},
    "canonical_baseline_commit": {"const": "40a826af29410af1a14c6a7dec3193cd59ba9b12"},
    "local_predecessor_commit": {"const": "40a826af29410af1a14c6a7dec3193cd59ba9b12"},
    "candidate_status": {"const": "LOCAL_CANDIDATE_NOT_PRODUCT_EXECUTION"},
    "feature_ids": {"type": "array", "minItems": 409, "maxItems": 409, "uniqueItems": true, "items": {"type": "string"}},
    "evidence_entries": {
      "type": "array",
      "minItems": 1242,
      "maxItems": 1242,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_key", "class", "path", "locator_kind", "locator", "stage_role"],
        "properties": {
          "evidence_key": {"type": "string"},
          "class": {"const": "IMPLEMENTATION_TARGET_CELL_CONTRACT"},
          "path": {"const": "spec/contracts/implementation-target-global-trace-closure-r1.json"},
          "locator_kind": {"const": "JSON_POINTER"},
          "locator": {"pattern": "^/cells/[0-9]+$"},
          "stage_role": {"type": "string"}
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1242,
      "maxItems": 1242,
      "items": {
        "type": "object",
        "required": ["feature_id", "stage", "outcome", "predecessor_disposition", "disposition", "evidence_keys", "delegate_feature_id", "not_applicable"]
      }
    },
    "counts": {"const": {"feature_count": 409, "evidence_entry_count": 1242, "binding_count": 1242, "bound_direct_count": 1236, "not_applicable_count": 6, "remaining_blocked_count": 0}},
    "guards": {"type": "object"}
  }
}
