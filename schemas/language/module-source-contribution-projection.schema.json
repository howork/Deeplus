{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplus-lang.org/schema/r51f3/module-source-contribution-projection.schema.json",
  "title": "Deeplus module source contribution provenance projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target_id",
    "module_id",
    "source_contributions",
    "projection_sha256"
  ],
  "properties": {
    "schema": {
      "const": "deeplus.module-source-contribution-projection/r1"
    },
    "target_id": {
      "type": "string",
      "pattern": "^TargetId:[^\\s]+$"
    },
    "module_id": {
      "type": "string",
      "pattern": "^ModuleId:[^\\s]+$"
    },
    "source_contributions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourceContribution"
      }
    },
    "projection_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_file_id",
        "normalized_project_relative_path",
        "source_role",
        "activation_profile",
        "source_bytes_sha256"
      ],
      "properties": {
        "source_file_id": {
          "type": "string",
          "pattern": "^SourceFileId:[^\\s]+$"
        },
        "normalized_project_relative_path": {
          "type": "string",
          "minLength": 1
        },
        "source_role": {
          "enum": [
            "library",
            "executable",
            "script"
          ]
        },
        "activation_profile": {
          "type": "string",
          "minLength": 1
        },
        "source_bytes_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "x-deeplus-digest-canonicalization": {
    "algorithm": "DEEPLUS_CANONICAL_JSON_UTF8_SHA256_V1",
    "self_hash_field_excluded": "projection_sha256",
    "array_order": {
      "source_contributions": "SourceFileId"
    },
    "identity_domain": "PROVENANCE_BUILD_ONLY_NOT_INTERFACE_OR_IMPLEMENTATION_SEMANTICS"
  },
  "x-deeplus-product-compiler": "NOT_RUN"
}
