{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deeplus.dev/schemas/language/unified-call-tilde-evidence-r1.schema.json",
  "title": "Deeplus R57 unified-call trace evidence overlay",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "revision", "canonical_baseline_commit", "local_predecessor_commit", "candidate_status", "feature_ids", "evidence_entries", "bindings", "acceptance_cases", "counts", "guards"],
  "properties": {
    "$schema": {"const": "../../../schemas/language/unified-call-tilde-evidence-r1.schema.json"},
    "schema": {"const": "deeplus.unified-call-tilde-evidence/r1"},
    "revision": {"const": "r57-local-unified-call-tilde-trace-closure-r1"},
    "canonical_baseline_commit": {"const": "39a5d50cc770341c4b9776d00d84520b780d0c62"},
    "local_predecessor_commit": {"const": "808bf7cd1d28bba737e0744a6f120c71297d7ddd"},
    "candidate_status": {"const": "NONCANONICAL_DESIGN_STATIC_EVIDENCE_OVERLAY"},
    "feature_ids": {"const": ["actor_declaration_grammar_closed", "actor_protocol_family", "data_shaping_callshape_model", "unified_call_expression_and_tilde_modes"]},
    "evidence_entries": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/evidenceEntry"}},
    "bindings": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/binding"}},
    "acceptance_cases": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/traceCase"}},
    "counts": {"type": "object"},
    "guards": {"type": "object"}
  },
  "$defs": {
    "evidenceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_key", "class", "path", "locator_kind", "locator", "stage_role"],
      "properties": {
        "evidence_key": {"pattern": "^R57:"},
        "class": {"enum": ["CONTRACT_RULE_ID", "ACCEPTANCE_CASE_SET"]},
        "path": {"const": "spec/contracts/unified-call-tilde-trace-closure-r1.json"},
        "locator_kind": {"enum": ["REGISTRY_ID", "JSON_POINTER"]},
        "locator": {"type": "string", "minLength": 1},
        "stage_role": {"type": "string", "minLength": 1}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "stage", "outcome", "disposition", "evidence_keys", "delegate_feature_id", "not_applicable"],
      "properties": {
        "feature_id": {"enum": ["actor_declaration_grammar_closed", "actor_protocol_family", "data_shaping_callshape_model", "unified_call_expression_and_tilde_modes"]},
        "stage": {"enum": ["STATIC_SEMANTICS", "DYNAMIC_LOWERING", "CONFORMANCE_TESTS"]},
        "outcome": {"type": ["string", "null"]},
        "disposition": {"enum": ["BOUND_DIRECT", "BOUND_DELEGATED"]},
        "evidence_keys": {"type": "array", "minItems": 1, "maxItems": 1},
        "delegate_feature_id": {"type": ["string", "null"]},
        "not_applicable": {"type": "null"}
      }
    },
    "traceCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "feature_id", "outcome", "contract_pointer", "acceptance_case_ids", "disposition", "delegate_feature_id", "execution_state"],
      "properties": {
        "case_id": {"pattern": "^R57-TRACE-00[1-7]$"},
        "feature_id": {"type": "string"},
        "outcome": {"enum": ["POSITIVE", "BOUNDARY", "REJECT"]},
        "contract_pointer": {"type": "string"},
        "acceptance_case_ids": {"type": "array", "minItems": 1, "uniqueItems": true},
        "disposition": {"enum": ["BOUND_DIRECT", "BOUND_DELEGATED"]},
        "delegate_feature_id": {"type": ["string", "null"]},
        "execution_state": {"const": "DESIGN_STATIC_NOT_RUN"}
      }
    }
  }
}
