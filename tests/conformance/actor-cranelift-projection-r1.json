  "cases": [
    {"case_id": "R24R-T01", "class": "positive", "scenario": "complete ObjectAot inputs consume one loader-verified executable Actor binding projection", "expected": "ACCEPT_ONE_DETERMINISTIC_ACTOR_CODE_GENERATION"},
    {"case_id": "R24R-T02", "class": "positive", "scenario": "complete InMemoryJit inputs consume the same verified MIR and binding projection", "expected": "ACCEPT_ONE_LEASE_GOVERNED_JIT_GENERATION"},
    {"case_id": "R24R-T03", "class": "positive", "scenario": "the external R23 executable projection passes its exact table, row, origin and owner checks", "expected": "BIND_VERIFIED_EXECUTABLE_PROJECTION_DIGEST"},
    {"case_id": "R24R-T04", "class": "positive", "scenario": "table rows, origins and binding row digests arrive in a different enumeration order", "expected": "ACTOR_CODE_GENERATION_ID_UNCHANGED_AFTER_CANONICAL_SORT"},
    {"case_id": "R24R-T05", "class": "positive", "scenario": "xVM, Object and JIT comparison consumes one shared non-null DeterministicScheduleTraceId", "expected": "EXACT_TOTAL_ORDER_ADMITTED"},
    {"case_id": "R24R-T06", "class": "positive", "scenario": "independent senders execute without a shared deterministic schedule identity", "expected": "COMPARE_EXACT_SEVEN_REQUIRED_PARTIAL_ORDER_INVARIANTS"},
    {"case_id": "R24R-T07", "class": "positive", "scenario": "a new JIT generation publishes before the old generation is unpublished", "expected": "EXISTING_ENVELOPES_TURNS_REQUESTS_AND_REPLIES_RETAIN_OLD_GENERATION"},
    {"case_id": "R24R-T08", "class": "positive", "scenario": "projection and differential receipts reproduce their canonical self digests", "expected": "RECEIPT_SELF_SEAL_ACCEPTED"},
    {"case_id": "R24R-T09", "class": "boundary", "scenario": "proof records zero safepoint, root, callback, suspended-frame and cleanup-entry obligations", "expected": "MANAGED_REFERENCE_NOT_REQUIRED_ADMITTED"},
    {"case_id": "R24R-T10", "class": "boundary", "scenario": "a generation is unpublished while one exact queued-envelope lease remains", "expected": "GENERATION_REMAINS_NOT_RETIRED"},
    {"case_id": "R24R-T11", "class": "boundary", "scenario": "dequeue transfers one lease from a queued envelope to an ActorTurn in one event", "expected": "NO_TRANSIENT_ZERO_OWNER_WINDOW"},
    {"case_id": "R24R-T12", "class": "boundary", "scenario": "request terminal decision occurs before Actor-side terminal cleanup completes", "expected": "ACTOR_REQUEST_TERMINAL_LEASE_REMAINS_UNTIL_CLEANUP"},
    {"case_id": "R24R-T13", "class": "boundary", "scenario": "caller Reply continuation generation differs from the Actor target generation", "expected": "DISTINCT_GENERATIONS_ADMITTED_WITH_SEPARATE_LEASE_RECEIPTS"},
    {"case_id": "R24R-T14", "class": "boundary", "scenario": "one-way SEND creates no caller Reply continuation", "expected": "NO_REPLY_CONTINUATION_LEASE_CREATED"},
    {"case_id": "R24R-T15", "class": "boundary", "scenario": "ObjectAot image lifetime is process or image-unload scoped", "expected": "LOGICAL_ZERO_LEASE_DOES_NOT_CLAIM_INDEPENDENT_PHYSICAL_RETIREMENT"},
    {"case_id": "R24R-T16", "class": "negative", "scenario": "one of the exact twenty-three current Cranelift base receipt inputs is absent", "expected": "ACTOR_CRANELIFT_BASE_RECEIPT_INCOMPLETE"},
    {"case_id": "R24R-T17", "class": "negative", "scenario": "ActorId, ActorInstanceId, ExecutableImageId or ActorCodeGenerationId are aliased", "expected": "ACTOR_CRANELIFT_GENERATION_ID_MISMATCH"},
    {"case_id": "R24R-T18", "class": "negative", "scenario": "MIR-to-CLIF lowering performs selector lookup, fallback or provider reselection", "expected": "ACTOR_CRANELIFT_BINDING_RESELECTION_FORBIDDEN"},
    {"case_id": "R24R-T19", "class": "negative", "scenario": "the bound executable projection table-set, row or origin coverage digest is stale", "expected": "ACTOR_CRANELIFT_BINDING_PROJECTION_INVALID"},
    {"case_id": "R24R-T20", "class": "negative", "scenario": "serialized preprojection inputs do not reproduce ActorCodeGenerationId", "expected": "ACTOR_CRANELIFT_GENERATION_ID_MISMATCH"},
    {"case_id": "R24R-T21", "class": "negative", "scenario": "one ActorCodeLeaseId is acquired twice without an intervening terminal release", "expected": "ACTOR_CRANELIFT_LEASE_EVENT_INVALID"},
    {"case_id": "R24R-T22", "class": "negative", "scenario": "one ActorCodeLeaseId is released twice or released before acquisition", "expected": "ACTOR_CRANELIFT_LEASE_EVENT_INVALID"},
    {"case_id": "R24R-T23", "class": "negative", "scenario": "Actor request terminal obligation releases before terminal cleanup and suppressed-failure observation", "expected": "ACTOR_CRANELIFT_GENERATION_LIFETIME_VIOLATION"},
    {"case_id": "R24R-T24", "class": "negative", "scenario": "runtime requires caller continuation generation to equal Actor generation", "expected": "ACTOR_CRANELIFT_CALLER_GENERATION_COUPLING_INVALID"},
    {"case_id": "R24R-T25", "class": "negative", "scenario": "JIT generation retires while published, leased, executing or metadata reachable", "expected": "ACTOR_CRANELIFT_GENERATION_LIFETIME_VIOLATION"},
    {"case_id": "R24R-T26", "class": "negative", "scenario": "ObjectAot claims independent physical retirement when only one logical generation reaches zero leases", "expected": "ACTOR_CRANELIFT_GENERATION_LIFETIME_VIOLATION"},
    {"case_id": "R24R-T27", "class": "negative", "scenario": "NOT_REQUIRED is claimed with a nonzero managed reference obligation or raw-pointer fallback", "expected": "ACTOR_CRANELIFT_MANAGED_REFERENCE_CAPABILITY_MISSING"},
    {"case_id": "R24R-T28", "class": "negative", "scenario": "cross-sender total order is claimed without replay identity or single-channel proof", "expected": "ACTOR_CRANELIFT_SCHEDULE_COMPARISON_INVALID"},
    {"case_id": "R24R-T29", "class": "negative", "scenario": "partial-order comparison omits or changes one required lifecycle invariant", "expected": "ACTOR_CRANELIFT_OBSERVATION_INVARIANT_MISMATCH"},
    {"case_id": "R24R-T30", "class": "negative", "scenario": "a design-static fixture claims backend execution or product support", "expected": "PRODUCT_EXECUTION_OVERCLAIM_REJECTED"}
  ],
