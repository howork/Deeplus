{
  "schema": "deeplus.parser-contexts/dpg1",
  "purpose": "Closed parser-facing surface sets and owner admission tables extracted from the attached CURRENT grammar. These values are not lexer keyword reclassifications.",
  "source": {
    "deeplus_ebnf_git_blob_sha1": "d901cf6acb672cf77051e53d09020f3f43d4a01c",
    "deeplus_ebnf_sha256": "914399e4fd35f552cab3111613244cb6844b6313f8b9bd17ebbead0ad7df9bd9",
    "keyword_vocabulary_git_blob_sha1": "51dd7b44b588757f91535a61f33d182103f3f958",
    "keyword_vocabulary_sha256": "dfed1c57701a47f002fcdd151cebdc7a079a0bd0d69e6b64ed9f13e3d9818bd4"
  },
  "dpg_metamodel": {
    "version": "DPG/1",
    "grammar_path": "spec/grammar/deeplus.dpg",
    "role": "lightweight structural contract for a Rust handwritten parser",
    "closed_external_binding_law": "every @Set, dispatch<Table,C>, admit<P>, pratt<D,M>, scanner outcome, LB and END reference in the DPG resolves here or through one exact referenced canonical contract",
    "unknown_binding": "INVALID_DPG_CONTRACT",
    "source_language_expansion_by_recovery": false
  },
  "surface_sets": {
    "TopLevelVisibility": [
      "public",
      "private",
      "common"
    ],
    "MemberVisibility": [
      "+",
      "-",
      "#"
    ],
    "ClassDispatchMarker": [
      ".",
      "+",
      "*.",
      "*+"
    ],
    "TraitWitnessMarker": [
      ".",
      "+",
      "*.",
      "*+"
    ],
    "VarianceMarker": [
      "out",
      "in"
    ],
    "TypeParameterKind": [
      "type",
      "StaticInt",
      "EffectRow",
      "ErrorSet"
    ],
    "OrderedComparison": [
      "<",
      "<=",
      ">",
      ">="
    ],
    "LawAssertionPrefix": [
      "requires",
      "ensures",
      "invariant"
    ],
    "ParameterMode": [
      "borrow",
      "mut",
      "move",
      "inout"
    ],
    "ClassFlavor": [
      "value",
      "resource"
    ],
    "ClassModifierSequence": [
      [
        "final"
      ],
      [
        "open"
      ],
      [
        "abstract"
      ],
      [
        "sealed"
      ],
      [
        "abstract",
        "sealed"
      ]
    ],
    "TraitLanguageRole": [
      "operator",
      "iteration",
      "interpolation",
      "binding"
    ],
    "EnumOrderRole": [
      "increasing",
      "decreasing"
    ],
    "ScopeModifier": [
      "isolated",
      "cancellable",
      "shielded"
    ],
    "CaptureMode": [
      "borrow",
      "inout",
      "move",
      "clone",
      "deep",
      "copy",
      "once"
    ],
    "MutableListInsertSuffix": [
      ["[", "@", "SliceIndexExpr", "]"],
      ["[", "SliceIndexExpr", "@", "]"],
      ["[", "@", "^", "]"],
      ["[", "$", "@", "]"]
    ],
    "MutableListRemoveSuffix": [
      ["[", "-", "@", "SliceIndexExpr", "]"],
      ["[", "-", "@", "SliceRange", "]"],
      ["[", "-", "@", "TupleOfSliceIndexExpr", "]"],
      ["[", "-", "^", "]"],
      ["[", "-", "$", "]"]
    ]
  },
  "owner_member_sets": {
    "class": [
      "field_decl",
      "member_function",
      "constructor_decl",
      "cleanup_decl",
      "type_field_decl",
      "type_member_function",
      "accessor_property",
      "conform_block",
      "forward_decl"
    ],
    "trait": [
      "trait_function",
      "associated_requirement",
      "law_decl"
    ],
    "conformance": [
      "conformance_method",
      "type_member_function",
      "associated_binding",
      "extension_delegate",
      "law_decl"
    ],
    "extension_set": [
      "extension_set_function",
      "type_member_function"
    ],
    "enum": [
      "member_function",
      "type_field_decl",
      "type_member_function",
      "accessor_property",
      "conform_block",
      "enum_subset_alias"
    ],
    "actor": [
      "actor_on_decl",
      "actor_request_decl",
      "field_decl",
      "member_function",
      "constructor_decl",
      "cleanup_decl",
      "type_field_decl",
      "type_member_function",
      "accessor_property",
      "forward_decl",
      "actor_protocol_conform_block"
    ],
    "actor_protocol_conformance": [
      "actor_on_decl",
      "actor_request_decl"
    ],
    "actor_protocol": [
      "actor_protocol_send_requirement",
      "actor_protocol_request_requirement"
    ],
    "bitfield": [
      "member_function",
      "type_field_decl",
      "type_member_function",
      "accessor_property",
      "law_decl"
    ]
  },
  "source_role_policy": {
    "library": {
      "plain": [
        "import_or_use",
        "nonbinding_top_decl",
        "top_binding"
      ],
      "annotatable": [
        "import_or_use",
        "nonbinding_top_decl",
        "top_binding"
      ],
      "shebang": false
    },
    "executable": {
      "plain": [
        "import_or_use",
        "nonbinding_top_decl",
        "entry_function"
      ],
      "annotatable": [
        "import_or_use",
        "nonbinding_top_decl",
        "entry_function"
      ],
      "shebang": false
    },
    "script": {
      "plain": [
        "import_or_use",
        "nonbinding_top_decl",
        "stmt"
      ],
      "annotatable": [
        "import_or_use",
        "nonbinding_top_decl"
      ],
      "shebang": true
    }
  },
  "call_argument_policy": {
    "parenthesized_comma": {
      "min": 1,
      "trailing_comma": true
    },
    "parenthesized_layout": {
      "min_named_rows": 2,
      "trailing_linebreak": true
    },
    "tilde": {
      "min": 1,
      "trailing_comma": false,
      "status": "CURRENT_INTENTIONAL_ASYMMETRY",
      "rationale": "a tilde sequence has no closing delimiter that can own a trailing comma; an outer comma after a nested tilde call requires parentheses"
    },
    "trailing_closure": {
      "multiple_requires_all_labels": true
    }
  },
  "pattern_policy": {
    "binding_root": {
      "top_level_typed_binding_atom": false,
      "whole_pattern_type_annotation": true,
      "structural_children_mode": "general"
    },
    "general": {
      "top_level_typed_binding_atom": true,
      "whole_pattern_type_annotation": false,
      "structural_children_mode": "general"
    },
    "assignee": {
      "root_forms": [
        "tuple",
        "list",
        "record",
        "nominal"
      ],
      "bare_name_or_wildcard_at_root": false,
      "nested_item_forms": [
        "name",
        "_",
        "tuple",
        "list",
        "record"
      ],
      "nominal_allowed_as_nested_item": false,
      "rest": true,
      "or_alias_move_literal_map_variant": false
    }
  },
  "mutable_list_edit_suffixes": {
    "insert": [
      [
        "[",
        "@",
        "SliceIndexExpr",
        "]"
      ],
      [
        "[",
        "SliceIndexExpr",
        "@",
        "]"
      ],
      [
        "[",
        "@",
        "^",
        "]"
      ],
      [
        "[",
        "$",
        "@",
        "]"
      ]
    ],
    "remove": [
      [
        "[",
        "-",
        "@",
        "SliceIndexExpr",
        "]"
      ],
      [
        "[",
        "-",
        "@",
        "SliceRange",
        "]"
      ],
      [
        "[",
        "-",
        "@",
        "TupleOfSliceIndexExpr",
        "]"
      ],
      [
        "[",
        "-",
        "^",
        "]"
      ],
      [
        "[",
        "-",
        "$",
        "]"
      ]
    ]
  },
  "externalized_registries": {
    "hard_and_contextual_words": "inputs/keyword-vocabulary.json",
    "pratt_binding_and_parselet_registration": "spec/frontend/frontend-model.json (existing canonical owner; not duplicated here)",
    "boundary_and_attachment": "existing BoundaryContext / owner policies",
    "recovery": "handwritten parser recovery table/algorithm",
    "cst_to_ast": "existing CST/AST normalization contracts",
    "expression_type_unit_pratt": "spec/frontend/frontend-model.json and handwritten parser parselet tables; DPG names only entry domains/modes"
  },
  "parser_dispatch": {
    "member_parser_map": {
      "field_decl": "Field",
      "member_function": "Function<member>",
      "constructor_decl": "Constructor",
      "cleanup_decl": "Cleanup",
      "type_field_decl": "TypeField",
      "type_member_function": "Function<type_member>",
      "accessor_property": "Accessor",
      "conform_block": "ConformBlock",
      "forward_decl": "Forward",
      "trait_function": "Function<trait>",
      "associated_requirement": "AssociatedRequirement",
      "law_decl": "Law",
      "conformance_method": "Function<conformance>",
      "associated_binding": "AssociatedBinding",
      "extension_delegate": "ExtensionDelegate",
      "extension_set_function": "Function<extension_set>",
      "enum_subset_alias": "EnumSubsetAlias",
      "actor_on_decl": "ActorOn",
      "actor_request_decl": "ActorRequest",
      "actor_protocol_conform_block": "ActorProtocolConform",
      "actor_protocol_send_requirement": "ProtocolSend",
      "actor_protocol_request_requirement": "ProtocolRequest"
    },
