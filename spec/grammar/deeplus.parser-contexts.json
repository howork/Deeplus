      "INTERPOLATION_OPEN",
      "INTERPOLATION_CLOSE",
      "INTERPOLATION_FORMAT_TEXT",
      "INTERPOLATION_BOUNDARY",
      "STRING_END"
    ],
    "external_parser_slots": {
      "MATCH_SUBJECT_BY_INPUT_SUPPLY_POLICY": "spec/frontend/frontend-model.json#/input_supply_policy",
      "MATCH_ARM_SEPARATOR_BY_CONTEXT": "spec/frontend/frontend-model.json#/boundary_policies",
      "MATCH_ARM_BODY_BY_CONTEXT": "spec/frontend/frontend-model.json#/input_supply_policy",
      "MUTABLE_LIST_EDIT_RECEIVER_BY_OWNER": "spec/frontend/frontend-model.json#/mutable_list_structural_edit_frontend_contract"
    },
    "metanodes": {
      "LB": "spec/frontend/frontend-model.json#/boundary_policies",
      "END": "spec/frontend/frontend-model.json#/boundary_policies"
    },
    "admission_predicates": {
      "TagPolicy": "spec/frontend/frontend-model.json#/modifier_admission",
      "ParameterPolicy": "spec/frontend/frontend-model.json#/admission_policies/parameter",
      "WhereAllowed": "#/callable_context_policy/where_allowed",
      "NonEmpty": "#/combinator_contracts",
      "EnumBodyCommit": "#/commitment_policy",
      "ConformanceRoutePolicy": "spec/frontend/frontend-model.json#/trait_conformance_surface_contract",
      "ForAwaitAttached": "#/commitment_policy/for_await",
      "TupleIdentity": "spec/frontend/frontend-model.json#/pattern_frontend_contract",
      "ListRestPolicy": "#/pattern_policy",
      "MutableListEditPolicy": "spec/frontend/frontend-model.json#/mutable_list_structural_edit_frontend_contract",
      "SpawnOperand": "spec/frontend/frontend-model.json#/concurrency_frontend_contract/spawn_contract"
    },
    "dispatch_tables": {
      "MemberSet": [
        "#/owner_member_sets",
        "#/parser_dispatch/member_parser_map"
      ],
      "PatternAtomSet": ["#/parser_dispatch/pattern_atom_set"],
      "ExpressionPrimary": ["#/parser_dispatch/expression_primary"]
    },
    "pratt_entries": {
      "Expression,normal": "spec/frontend/frontend-model.json#/pratt/expression",
      "Expression,predicate": "spec/frontend/frontend-model.json#/pratt/expression",
      "Expression,slice_index": "spec/frontend/frontend-model.json#/pratt/slice_index",
      "Type,normal": "spec/frontend/frontend-model.json#/pratt/type",
      "Type,non_function_top": "spec/frontend/frontend-model.json#/pratt/type",
      "Unit,normal": "spec/frontend/frontend-model.json#/pratt/unit"
    }
  },
  "commitment_policy": {
    "for_await": "`#` followed by contextual `await` must be the existing attached role; attachment is checked by parser context/scanner trivia boundary, not encoded by CFG expansion",
    "mutable_list_edit": "commit to structural edit only after one exact suffix marker from mutable_list_edit_suffixes",
    "deferred_message": "defer message form accepts `~` only; `:~` remains excluded",
    "tilde_call": "ordinary message call accepts `~` or `:~`; tilde argument sequence has no trailing comma",
    "preview_gate": "required exactly once at the front of Preview source role",
    "closure_arrow": "if `=>` is selected, LambdaBody is mandatory; otherwise empty/body closure remains available"
  },
  "combinator_contracts": {
    "list<X,min,trail>": {
      "separator": ",",
      "min_parameter": "minimum item count",
      "trail=yes": "optional trailing comma",
      "trail=no": "trailing comma rejected"
    },
    "rows<X,min>": {
      "shape": "LB X (LB X)* [LB]",
      "min_parameter": "minimum row count",
      "note": "used only in owners whose current grammar admits physical-line layout"
    },
    "entries<X>": {
      "separator": "comma optionally followed by LB, or LB",
      "shape": "X ((, [LB] | LB) X)* [(, [LB] | LB)]",
      "min_items": 1,
      "note": "wrap in [...] when the owner admits zero entries"
    }
  },
  "pratt_external_surface_words": {
    "type_prefix_ownership": [
      "owned",
      "borrowed",
      "mut",
      "inout"
    ],
    "expression_prefix_words": [
      "not",
      "move",
      "borrow",
      "await"
    ],
    "note": "Binding powers/associativity remain in the existing canonical Pratt registry; this list is only an audit projection of word-spelled prefix surfaces."
  },
  "pratt_external_surface_operators_audit_only": [
    "&",
    "~~"
  ]
}
