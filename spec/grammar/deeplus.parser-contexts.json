  "callable_context_policy": {
    "where_allowed": {
      "normal": true,
      "entry": false,
      "trait": true
    },
    "function_end": {
      "normal": "FunctionBody",
      "entry": "FunctionBody",
      "trait": "FunctionBody | END"
    },
    "extension_set_contract_clauses": false,
    "cleanup_allows_return_clause": false,
    "cleanup_allows_where_clause": false
  },
  "source_profile_policy": {
    "stable": {
      "preview_gate": "forbidden"
    },
    "preview": {
      "preview_gate": "required"
    },
    "preview_ffi_annotation_attachment": false
  },
  "boundary_policy": {
    "LB": "physical line break found in lossless trivia; parser metanode, not lexer token",
    "END": "statement boundary decided by BoundaryContext (newline/semicolon/root EOF as already canonical)",
    "grammar_does_not_relex_trivia": true
  },
  "scanner_attachment_policy": {
    "actor_message": {
      "surface": ":~",
      "scanner_outcome": "COLON_TILDE",
      "longest_match_before_single_character_tokens": true,
      "trivia_between_colon_and_tilde": false,
      "spaced_colon_tilde_is_actor_message": false
    },
    "message": {
      "surface": "~",
      "scanner_outcome": "TILDE"
    },
    "for_await": {
      "surface": "#await",
      "scanner_outcome": "HASH then contextual await",
      "attachment_owner": "ParserContext"
    }
  },
  "closed_external_bindings": {
    "scanner_outcomes": [
      "IDENTIFIER",
      "WILDCARD",
      "NUMERIC_LITERAL",
      "IMAGINARY_LITERAL",
      "RATIONAL_LITERAL",
      "CHAR_LITERAL",
      "BYTES_LITERAL",
      "PLAIN_STRING_LITERAL",
