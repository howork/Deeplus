  "rules": [
    {
      "rule_id": "H1MB-R001",
      "title": "machine schemas are current Stable design without product activation",
      "contract": "The bounded HIR/MIR machine schemas and registries, including the R31 closure-capture projection, are current Stable-design authorities. They create no source activation, canonical instance, implementation, execution, backend switch, P1 closure, or product support."
    },
    {
      "rule_id": "H1MB-R002",
      "title": "phase authority is represented by distinct types",
      "contract": "HirSkeleton, AnalysisHir, TypedHirDraft, Verified<CanonicalHirH1>, ExecutableHirH1, and Verified<DeeplusMirR1> are distinct authority-bearing types rather than one node graph with a phase flag."
    },
    {
      "rule_id": "H1MB-R003",
      "title": "canonical HIR is closed",
      "contract": "Canonical HIR is fully typed, resolved, responsibility-closed, canonical, and verified; invalid, unresolved, candidate, inference, error-type, missing-expression, and backend-layout variants are unrepresentable."
    },
    {
      "rule_id": "H1MB-R004",
      "title": "static selections survive lowering",
      "contract": "Selected callable, conformance, witness, requirement, extension, activation, formal, provider, actor, and authority identities remain typed fields and are never recovered from strings or runtime lookup."
    },
    {
      "rule_id": "H1MB-R005",
      "title": "evaluation order and formal binding are distinct",
      "contract": "Source operands and call inputs retain one total evaluate-once order while formal/channel binding is a separate static projection."
    },
    {
      "rule_id": "H1MB-R006",
      "title": "power has a closed operation enum",
      "contract": "Every admitted power expression seals to exactly one of CheckedIntPow, FloatPowInt, FloatPow, ComplexPowInt, ComplexPowPrincipal, or MeasurePowStatic; generic or unresolved Pow is forbidden."
    },
    {
      "rule_id": "H1MB-R007",
      "title": "power adaptation is closed and explicit",
      "contract": "Each operand uses exactly one Identity, DirectLiteralToF64Exact, F32ToF64, F32ToComplex64, or F64ToComplex64 adaptation; hidden conversion and adaptation inferred in MIR are forbidden."
    },
    {
      "rule_id": "H1MB-R008",
      "title": "power selection is static",
      "contract": "Expected result type, runtime sign, runtime integrality, Trait or witness search, provider lookup, source/import order, runtime fallback, and backend never select a power operation or result type."
    },
    {
      "rule_id": "H1MB-R009",
      "title": "base precedes exponent exactly once",
      "contract": "The base expression evaluates once, then the exponent expression evaluates once, then the sealed power operation executes once."
    },
    {
      "rule_id": "H1MB-R010",
      "title": "math profiles are semantic dependencies",
      "contract": "Every floating or complex power plan binds exact math_profile_id and special_value_profile_id values into semantic identity; host libm selection cannot replace them."
    },
    {
      "rule_id": "H1MB-R011",
      "title": "fixed glyph conformance remains bounded",
      "contract": "Stable fixed-glyph conformance admits exactly 13 roles: unary +/-, binary +,-,*,/,% and ==,!=,<,<=,>,>= through the nine closed Prelude Trait roots; != and the four ordering glyphs are derived projections, while power, range, compound assignment and arbitrary custom operators admit no independent conformance route."
    },
    {
      "rule_id": "H1MB-R012",
      "title": "Rational constants are normalized without activation",
      "contract": "RationalConst refers to one reduced positive-denominator ConstRational canonical payload and creates no Rational source literal, power adaptation, Prelude identity, or runtime implementation."
    },
    {
      "rule_id": "H1MB-R013",
      "title": "Complex constant bits preserve signed zero",
      "contract": "ComplexPayload binds Float32 to exact eight-hex-digit component bits and Float64 to exact sixteen-hex-digit component bits, preserving component order, signed zero, and NaN payloads without selecting layout or ABI."
    },
    {
      "rule_id": "H1MB-R014",
      "title": "capability receipt gates executable HIR",
      "contract": "Verified canonical HIR becomes ExecutableHirH1 only when a recomputed MirCapabilityReceiptR1 covers every reachable lowering key and exact transitive capability dependency; failure preserves the verified HIR."
    },
    {
      "rule_id": "H1MB-R015",
      "title": "capability is not execution authority",
      "contract": "MirCapabilityReceipt proves bounded lowering coverage only; it does not authorize execution, implementation, MIR-X1 adoption, publication, or backend change."
    },
    {
      "rule_id": "H1MB-R016",
      "title": "HIR to MIR is deterministic expansion",
      "contract": "Lowering introduces CFG, Value, Place, token, cleanup, outcome, and suspension structure but performs no semantic lookup, conversion, fallback, or policy invention."
    },
    {
      "rule_id": "H1MB-R017",
      "title": "pair verification relowers",
      "contract": "A HIR/MIR pair is accepted only after deterministic relowering and canonical semantic-byte plus provenance comparison; matching independent digest strings are insufficient."
    },
    {
      "rule_id": "H1MB-R018",
      "title": "MIR-X1 remains noncanonical",
      "contract": "ProposedMirX1 remains a noncanonical nonactivatable compatibility target. The current machine output is Verified<DeeplusMirR1>."
    },
    {
      "rule_id": "H1MB-R019",
      "title": "the bridge observes current backend authority without reselecting it",
      "contract": "The externally ratified current backend path is xVM initial execution, Cranelift ObjectModule AOT, and Cranelift JITModule. Managed references use the external deterministic deeplus.managed-memory-plan/r1 under STW_NONMOVING_TRACING_WITH_OPAQUE_STABLE_HANDLES_R1; target root locations never enter HIR. This bridge cannot select xVM-only, restore a superseded native path, or claim product execution."
    },
    {
      "rule_id": "H1MB-R020",
      "title": "evidence boundaries remain exact",
      "contract": "Semantic P0 remains zero, the exact 22 feature P1 remain OPEN, M13-A002 through A005 remain separate, every product lane remains NOT_RUN, and static fixtures are not implementation receipts."
    },
    {
      "rule_id": "H1MB-R021",
      "title": "suspension frames preserve responsibility atomically",
      "contract": "Every suspension point binds one closed ContinuationFramePlan and exact ContinuationInterfaceId/digest. Suspension commit atomically transfers the owner, admitted-loan, cleanup-token, and retained-authority partition; managed storage-location roots are bijectively rebound to fresh destination RootIds before source removal. A fresh epoch admits exactly one resume-or-cancel winner, and every terminal path has zero responsibility balance."
    },
    {
      "rule_id": "H1MB-R019",
      "title": "the bridge observes current backend authority without reselecting it",
      "contract": "The externally ratified current backend path is xVM initial execution, Cranelift ObjectModule AOT, and Cranelift JITModule. This HIR bridge adds no backend-specific HIR field and cannot select xVM-only, restore a superseded native path, or claim product execution."
    },
    {
      "rule_id": "H1MB-R021",
      "title": "closure capture construction is transactional without new MIR operations",
      "contract": "Tagged ReferenceCapture and InitializerCapture fields evaluate left-to-right exactly once into a private builder; COPY and CLONE preserve one exact ResponsibilityEvidenceId disjoint from callable ResponsibilityProfileId; MOVE and ONCE reserve without PLACE_MOVE while fallible work remains; failure uses CHECKED or LEAVE and reverse rollback with source owners unconsumed; after all fallible preparation one straight-line nonsuspending interval performs source-ordered PLACE_MOVE and BUILDER_STAGE for MOVE or ONCE, BUILDER_COMMIT, and infallible CLOSURE_MAKE; DEEP has zero typed-HIR/MIR rows, partial publication is forbidden, and no capture/value identity enters module API bytes."
    }
  ],
