  "rules": [
    {
      "rule_id": "MRM-R001",
      "law": "Phase 1 uses stop-the-world nonmoving full-heap tracing with opaque stable handles."
    },
    {
      "rule_id": "MRM-R002",
      "law": "Handle and object addresses are never language, module-API, serialization or ABI identities."
    },
    {
      "rule_id": "MRM-R003",
      "law": "Every managed type has one semantic trace descriptor with ordered logical projections."
    },
    {
      "rule_id": "MRM-R004",
      "law": "Safepoints are closed, explicit semantic sites; backend insertion is forbidden."
    },
    {
      "rule_id": "MRM-R005",
      "law": "A root receipt equals the sorted unique union of pairwise-disjoint running, frame and runtime roots."
    },
    {
      "rule_id": "MRM-R006",
      "law": "Root identity denotes storage location; the static plan contains no generation value and each runtime root receipt binds the exact nonnegative handle generation."
    },
    {
      "rule_id": "MRM-R007",
      "law": "The runtime root receipt is verified and published before a may-collect entry, lives through outcome commit, and is then released."
    },
    {
      "rule_id": "MRM-R008",
      "law": "Allocation fast paths cannot collect; slow paths use an explicit INVOKE of the sealed managed.allocate_slow runtime helper."
    },
    {
      "rule_id": "MRM-R009",
      "law": "Managed allocation is transactional and fails only through existing AllocationError effects allocate."
    },
    {
      "rule_id": "MRM-R010",
      "law": "The collector does not execute cleanup, consume cleanup tokens, deliver cancellation or select outcomes."
    },
    {
      "rule_id": "MRM-R011",
      "law": "Suspension transfers each source root to one distinct destination RootId with the same exact handle generation before removing active-frame roots, then commits exactly once."
    },
    {
      "rule_id": "MRM-R012",
      "law": "A raw interior address is confined to a proven no-collect region and cannot cross safepoint or FFI."
    },
    {
      "rule_id": "MRM-R013",
      "law": "Phase 1 exports no runtime managed handle or referent address through FFI."
    },
    {
      "rule_id": "MRM-R014",
      "law": "Phase 1 has no relocation, concurrent or generational collection, barriers, weak refs, finalizers or pinning surface."
    },
    {
      "rule_id": "MRM-R015",
      "law": "JIT image retirement requires unpublished state and zero active, suspended and root-receipt leases."
    },
    {
      "rule_id": "MRM-R016",
      "law": "Old activations and frames never rebind to a new JIT generation."
    },
    {
      "rule_id": "MRM-R017",
      "law": "xVM, Object AOT and JIT preserve identical logical root, ownership, cleanup and outcome traces."
    },
    {
      "rule_id": "MRM-R018",
      "law": "Target locations and collection timing are excluded from semantic parity identity."
    },
    {
      "rule_id": "MRM-R019",
      "law": "Missing or inconsistent capability, root, safepoint or lease evidence blocks projection."
    },
    {
      "rule_id": "MRM-R020",
      "law": "Static materialization changes no source syntax, feature P1, M13 action or product lane."
    }
  ],
