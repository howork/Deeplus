  "rules": [
    {
      "rule_id": "TQASSTC-R001",
      "text": "Only trait_qualified_associated_static_selection DYNAMIC_LOWERING transitions from APPLICABLE_BLOCKED_BY_GAP to BOUND_DIRECT."
    },
    {
      "rule_id": "TQASSTC-R002",
      "text": "R62 adds no source spelling, grammar production, AST or HIR node kind, MIR operation or terminator kind, runtime service, activation, or product-support claim."
    },
    {
      "rule_id": "TQASSTC-R003",
      "text": "One immutable TraitAssociatedStaticSelectionId binds exactly TraitId, RequirementId, ConformanceId, TraitWitnessId, ImplementationId, SubstitutionId, and ResponsibilityId."
    },
    {
      "rule_id": "TQASSTC-R004",
      "text": "For an associated function, ImplementationId projects one-to-one and injectively to CallableImplementationId before HIR emission; it is not an independent candidate selection."
    },
    {
      "rule_id": "TQASSTC-R005",
      "text": "Checked context fixes exactly one of associated_type, associated_value, or associated_function before HIR lowering, and a kind mismatch is terminal."
    },
    {
      "rule_id": "TQASSTC-R006",
      "text": "Associated values reuse HM-LR-REF-002 and HM-LR-TOP-002 for STATIC_REF then TOTAL_PROJECTION; associated functions reuse HM-LR-CALL-003 for STATIC_REF then INVOKE with ORDINARY::TRAIT_WITNESS preserved as the semantic target."
    },
    {
      "rule_id": "TQASSTC-R007",
      "text": "An associated type emits no runtime operation; a following member selector operates only in the normalized selected type's nominal type-side domain without Trait or extension fallback."
    },
    {
      "rule_id": "TQASSTC-R008",
      "text": "An associated value reaches HIR only when immutable, Shareable, no-drop, authority-free, acyclic, and statically materializable, and selection adds no activation or cache lifecycle."
    },
    {
      "rule_id": "TQASSTC-R009",
      "text": "Runtime witness lookup, candidate enumeration or ranking, provider search, fallback, order winner, specialization, child-local replacement, activation, new commit events, and runtime identity reconstruction all remain zero."
    },
    {
      "rule_id": "TQASSTC-R010",
      "text": "Inherited evidence retains its original ConformanceId and TraitWitnessId; a child cannot replace or specialize the selected parent evidence."
    },
    {
      "rule_id": "TQASSTC-R011",
      "text": "Normalized substitutions receive distinct selection identities where required, while source, import, use, link order and machine address never contribute semantic identity."
    },
    {
      "rule_id": "TQASSTC-R012",
      "text": "The six diagnostics in diagnostic_fence are the only rejection evidence admitted by R62, and R62 invents no new diagnostic."
    },
    {
      "rule_id": "TQASSTC-R013",
      "text": "TRAIT_ASSOCIATED_STATIC_AMBIGUOUS is not used as R62 evidence and remains a separate catalog-coherence follow-up."
    },
    {
      "rule_id": "TQASSTC-R014",
      "text": "Semantic P0 remains zero, feature P1 remains exactly 22 OPEN, M13 remains four OPEN actions, product lanes remain 15/15 NOT_RUN, and GitHub publication remains suspended."
    }
  ],
