  "rules": [
    {
      "rule_id": "NASIL-R001",
      "text": "ROW_COMMA and COLUMN_SEMICOLON are existing current STABLE_DESIGN forms; this contract adds no source surface."
    },
    {
      "rule_id": "NASIL-R002",
      "text": "Both inferred forms have semantic rank 1 and shape [N], with ROW or COLUMN orientation retained as distinct static identity."
    },
    {
      "rule_id": "NASIL-R003",
      "text": "Exact #1,N and #N,1 literals are rank-2 matrices and never become identical to either inferred rank-1 form."
    },
    {
      "rule_id": "NASIL-R004",
      "text": "An inferred NumericArray literal must contain at least one element."
    },
    {
      "rule_id": "NASIL-R005",
      "text": "The normalized AST preserves form, orientation, source element order, inferred rank and inferred shape."
    },
    {
      "rule_id": "NASIL-R006",
      "text": "Element typing uses only existing ordinary expression and contextual adaptation rules and must close one exact admitted numeric element type."
    },
    {
      "rule_id": "NASIL-R007",
      "text": "Element-type disagreement reports NUMARR_ELEMENT_TYPE_MISMATCH after all higher-priority structural or element-local failures."
    },
    {
      "rule_id": "NASIL-R008",
      "text": "Each element expression is evaluated exactly once from left to right."
    },
    {
      "rule_id": "NASIL-R009",
      "text": "Successful construction emits exactly one existing AGGREGATE_ASSEMBLE operation with semantic identity DM-SEMOP-AGGREGATE-ASSEMBLE-R1 and aggregate kind NUMERIC_ARRAY."
    },
    {
      "rule_id": "NASIL-R010",
      "text": "No element or aggregate value is partially published before successful assembly."
    },
    {
      "rule_id": "NASIL-R011",
      "text": "Failure cleans successfully initialized element temporaries in reverse initialization order and does not evaluate later elements."
    },
    {
      "rule_id": "NASIL-R012",
      "text": "Shape and orientation are carried by sealed semantic type identity and do not select backend layout or ABI."
    },
    {
      "rule_id": "NASIL-R013",
      "text": "Formatter and LSP preserve inferred form and orientation and do not rewrite to an exact rank-2 form."
    },
    {
      "rule_id": "NASIL-R014",
      "text": "Static validation is E2 evidence only; all product lanes remain NOT_RUN."
    }
  ],
