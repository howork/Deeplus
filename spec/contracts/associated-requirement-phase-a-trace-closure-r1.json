  "rules": [
    {
      "rule_id": "ARPTC-R001",
      "text": "AssociatedRequirementAdmitted is the sole controlling predicate for this Phase A conformance grouping; AssociatedRequirementWitnessAdmitted and WherePredicateAdmitted remain unchanged supporting predicates."
    },
    {
      "rule_id": "ARPTC-R002",
      "text": "The admitted requirement kind is exactly type, value, or function, and each requirement has exactly one compatible explicit or canonical inherited binding under TC-R010."
    },
    {
      "rule_id": "ARPTC-R003",
      "text": "Type bindings satisfy normalized bounds by subset, value bindings match the exact normalized value type, and function bindings match the exact normalized callable signature."
    },
    {
      "rule_id": "ARPTC-R004",
      "text": "Missing, duplicate, kind-conflicting, bounds-invalid, default-present, unresolved, ambiguous, incompatible, or cyclic bindings reject before HIR admission."
    },
    {
      "rule_id": "ARPTC-R005",
      "text": "Rejection selects the lowest detected numeric reason rank from one through four and then the canonical culprit identity; source order is never a semantic winner."
    },
    {
      "rule_id": "ARPTC-R006",
      "text": "Every rejection emits exactly one ASSOCIATED_REQUIREMENT_UNRESOLVED primary diagnostic and leaves every later candidate NOT_EVALUATED."
    },
    {
      "rule_id": "ARPTC-R007",
      "text": "This contract closes only design-static admission evidence and introduces no source, AST, HIR, MIR, runtime operation, or product-support claim."
    },
    {
      "rule_id": "ARPTC-R008",
      "text": "Projection selection and any existing static-reference or invoke lowering remain owned by trait_qualified_associated_static_selection and its R62 contract and are not imported here."
    }
  ],
