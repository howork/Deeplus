  "rules": [
    {
      "rule_id": "PMOSTC-R001",
      "text": "R60 transitions exactly pattern_match_ownership_split/STATIC_SEMANTICS and pattern_match_ownership_split/DYNAMIC_LOWERING from APPLICABLE_BLOCKED_BY_GAP to BOUND_DIRECT."
    },
    {
      "rule_id": "PMOSTC-R002",
      "text": "The normalized binder interface consists exactly of binder name, type, ownership mode, mutability, usable region, and capabilities; projection path and source order are not interface fields."
    },
    {
      "rule_id": "PMOSTC-R003",
      "text": "Every Or alternative must expose an exactly equal normalized binder interface; the first source-ordered successful alternative wins and no retry or backtracking is permitted."
    },
    {
      "rule_id": "PMOSTC-R004",
      "text": "A BORROWED binder never moves its source and an OWNED binder is admitted only when its exact source place can be reserved and moved once at final commit."
    },
    {
      "rule_id": "PMOSTC-R005",
      "text": "An Alias pattern is a same-subject shared borrow with no clone and conflicts with a moved or exclusively borrowed child."
    },
    {
      "rule_id": "PMOSTC-R006",
      "text": "Structural probing and optional guard evaluation acquire and publish no ownership state."
    },
    {
      "rule_id": "PMOSTC-R007",
      "text": "A pattern guard is read-only and nonescaping and must not consume, mutate, suspend, or acquire ownership state."
    },
    {
      "rule_id": "PMOSTC-R008",
      "text": "After structural and guard success, pending moves and loans are ordered by source-pattern preorder before the group commit."
    },
    {
      "rule_id": "PMOSTC-R009",
      "text": "One infallible group commit orders MOVE_RESERVE before PLACE_MOVE, LOAN_BEGIN_SHARED, or LOAN_BEGIN_EXCLUSIVE and publishes bindings only with the final BINDING_COMMIT."
    },
    {
      "rule_id": "PMOSTC-R010",
      "text": "Preparation abort uses MOVE_CANCEL in reverse acquisition order and publishes no binding, move, loan, view, authority, or reservation residue."
    },
    {
      "rule_id": "PMOSTC-R011",
      "text": "LOAN_END occurs at the earliest owner mutation, move, replacement, cleanup, or region frontier."
    },
    {
      "rule_id": "PMOSTC-R012",
      "text": "Normally returning arms require compatible place identity and place state and join by capability intersection; divergent arm contracts remain excluded."
    },
    {
      "rule_id": "PMOSTC-R013",
      "text": "clause_pattern_heads and match_exhaustiveness_phase_a are reverse dependents outside this bounded transition and no cell belonging to either feature changes."
    },
    {
      "rule_id": "PMOSTC-R014",
      "text": "R60 introduces no source surface, AST identity, HIR identity, or MIR operation kind; semantic P0 remains zero, feature P1 remains exactly 22 OPEN, M13 actions remain exactly four OPEN, all product lanes remain NOT_RUN, and GitHub publication remains suspended."
    }
  ],
