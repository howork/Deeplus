  "rules": [
    {
      "rule_id": "PCETC-R001",
      "text": "Only the five cells enumerated by scope_fence transition from APPLICABLE_BLOCKED_BY_GAP to BOUND_DIRECT."
    },
    {
      "rule_id": "PCETC-R002",
      "text": "R61 adds no source syntax, grammar production, AST/HIR identity, MIR operation kind, source activation, or product-support claim."
    },
    {
      "rule_id": "PCETC-R003",
      "text": "A declarative clause family receives the CLAUSE_FUNCTION_SUBJECT implicit parent parameter subject exactly once."
    },
    {
      "rule_id": "PCETC-R004",
      "text": "DeclarativeClausePartitionAdmitted is the controlling static judgment and admits only the exact current PCTX pattern kinds whose subject coverage is a finite closed cell set."
    },
    {
      "rule_id": "PCETC-R005",
      "text": "Source order is deterministic clause probe order only; overlap is rejected statically and source order never chooses an overlap winner."
    },
    {
      "rule_id": "PCETC-R006",
      "text": "Each admitted clause lowers as PatternAttempt, child probes and projections, one optional pure R0 guard, the R60 atomic commit, one selected body evaluation, declared return checking, and RETURN_TO LEAVE."
    },
    {
      "rule_id": "PCETC-R007",
      "text": "A pattern mismatch or false guard takes NEXT_DECLARATIVE_CLAUSE with zero published binding, move, loan, view, authority, or reservation residue."
    },
    {
      "rule_id": "PCETC-R008",
      "text": "A successful clause commits once, evaluates its body once, and never retries, backtracks, or probes a later clause."
    },
    {
      "rule_id": "PCETC-R009",
      "text": "Every normally returning clause body is assignable to the declared return type and exits the function through the existing RETURN_TO LEAVE contract."
    },
    {
      "rule_id": "PCETC-R010",
      "text": "Static exhaustive admission makes the all-clauses-failed edge unreachable and creates no implicit arm, fallback result, PatternMatchDefect, or runtime error residue."
    },
    {
      "rule_id": "PCETC-R011",
      "text": "Clause ownership, Or, Alias, move, loan, cancellation, and single-publication behavior import the exact R60 pattern-match ownership contract without reinterpretation."
    },
    {
      "rule_id": "PCETC-R012",
      "text": "Match usefulness and exhaustiveness use one normalized subject-restricted partition pass; guarded arms record mentions but never subtract coverage."
    },
    {
      "rule_id": "PCETC-R013",
      "text": "Match empty-arm, empty-otherwise, guard-only residual, and never-mentioned residual conditions select the four exact active diagnostics recorded by match_exhaustiveness_law."
    },
    {
      "rule_id": "PCETC-R014",
      "text": "Enum owner and payload admission precede coverage, so a foreign or malformed case selects ENUM_PATTERN_CASE_OR_PAYLOAD_MISMATCH before any exhaustiveness diagnostic."
    },
    {
      "rule_id": "PCETC-R015",
      "text": "Related feature cells, including pattern ownership, clause partition core, clause block syntax, and otherwise syntax, remain unchanged."
    },
    {
      "rule_id": "PCETC-R016",
      "text": "Semantic P0 remains zero, feature P1 remains exactly 22 OPEN, M13 remains four OPEN actions, product lanes remain 15/15 NOT_RUN, and GitHub publication remains suspended."
    }
  ],
