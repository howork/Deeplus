  "rules": [
    {
      "rule_id": "CLB-R001",
      "law": "Deeplus MIR remains the sole execution semantic authority."
    },
    {
      "rule_id": "CLB-R002",
      "law": "xVM remains the initial development, validation and REPL path."
    },
    {
      "rule_id": "CLB-R003",
      "law": "Object AOT and in-memory JIT share one verified-MIR-to-CLIF lowering."
    },
    {
      "rule_id": "CLB-R004",
      "law": "CLIF and every native identity are backend-private projections."
    },
    {
      "rule_id": "CLB-R005",
      "law": "Exact target, ISA, toolchain, module, internal ABI ID/schema/digest, helper registry, target projection, artifact-binding schema and optimization inputs are receipt bound."
    },
    {
      "rule_id": "CLB-R006",
      "law": "Error, Defect and Cancellation use the four-tag internal ABI outcome channel; suspension and cleanup remain separate explicit MIR transitions and actions."
    },
    {
      "rule_id": "CLB-R007",
      "law": "A backend trap requires a preselected Defect or verifier-proven unreachable site."
    },
    {
      "rule_id": "CLB-R008",
      "law": "Object mode records object, exact runtime helper symbols and linker identity; JIT mode records the exact helper allowlist, resolved signatures/providers, image generation and zero-lease retirement."
    },
    {
      "rule_id": "CLB-R009",
      "law": "Missing or invalid managed-memory profile, plan, root projection, runtime registry or image-lifetime evidence blocks native lowering."
    },
    {
      "rule_id": "CLB-R010",
      "law": "Debug projection is nonsemantic and digest separated."
    },
    {
      "rule_id": "CLB-R011",
      "law": "Product support remains NOT_RUN until target-bound receipts exist."
    },
    {
      "rule_id": "CLB-R012",
      "law": "The backend replacement changes no language feature P1 or semantic P0."
    }
  ]
