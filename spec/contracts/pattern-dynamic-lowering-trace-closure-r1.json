  "rules": [
    {"rule_id": "PDLTC-R001", "text": "R59 transitions exactly or_alias_pattern/DYNAMIC_LOWERING, pattern_binding_control_family/DYNAMIC_LOWERING, and pattern_decomposition/DYNAMIC_LOWERING from APPLICABLE_BLOCKED_BY_GAP to BOUND_DIRECT."},
    {"rule_id": "PDLTC-R002", "text": "The 29 CURRENT pattern lowering rows map one-to-one from PL through PK to HM-LR-PAT-001 through HM-LR-PAT-029; PL-OR maps exactly to PK-OR and HM-LR-PAT-027, PL-ALIAS maps exactly to PK-ALIAS and HM-LR-PAT-028, and decomposition obeys the shared probe, guard, commit, and failure laws in PDLTC-R004 through PDLTC-R008."},
    {"rule_id": "PDLTC-R003", "text": "The five current control contexts reuse HM-LR-TOP-016 plus the existing IF owner HM-LR-TOP-008 or LOOP owner HM-LR-TOP-011 and apply the shared probe, guard, commit, and context-failure laws in PDLTC-R004 through PDLTC-R008."},
    {"rule_id": "PDLTC-R004", "text": "A pattern attempt evaluates its subject once, performs one pure deterministic nonconsuming structural probe, and exposes probe binders read-only and nonescaping."},
    {"rule_id": "PDLTC-R005", "text": "An optional admitted pure Bool guard evaluates exactly once after structural success and zero times after structural failure."},
    {"rule_id": "PDLTC-R006", "text": "Only final structural and optional-guard success performs one logical infallible top-level binding commit."},
    {"rule_id": "PDLTC-R007", "text": "BINDING_COMMIT operations in subpattern HM rows are compositional commit requirements collapsed into the one HM-LR-TOP-016 commit and are never additional executable commits."},
    {"rule_id": "PDLTC-R008", "text": "Mismatch or false guard publishes zero binding, move, loan, view, or authority and selects the context-specific false, exit, or skip/discharge disposition."},
    {"rule_id": "PDLTC-R009", "text": "An Or pattern requires an exactly equal binder interface and selects the first source-ordered successful branch with no backtracking or retry; an Alias pattern is a same-subject borrow with no clone and acquires its actual loan only through the final top-level commit."},
    {"rule_id": "PDLTC-R010", "text": "An Alias pattern is a same-subject borrow with no clone; its actual loan is acquired only by the final top-level commit."},
    {"rule_id": "PDLTC-R011", "text": "Ownership conflicts and escape diagnostics delegate to pattern_match_ownership_split without transitioning either its STATIC_SEMANTICS or DYNAMIC_LOWERING cell."},
    {"rule_id": "PDLTC-R012", "text": "The ten direct reverse dependents of pattern_decomposition, every Preview pattern row, and every other target cell are outside this transition overlay."},
    {"rule_id": "PDLTC-R013", "text": "R59 introduces no source surface, AST identity, HIR identity, or MIR operation kind and supplies E2 design-static evidence only; all product lanes remain NOT_RUN and GitHub publication remains suspended."}
  ],
