  "rules": [
    {"rule_id": "UCTC-R001", "text": "Ordinary, message and actor-message invocation surfaces normalize to one CallExpr with exactly one CallMode."},
    {"rule_id": "UCTC-R002", "text": "The normalized AST preserves the ordered six-kind CallArgument family and a source-structure trailing-closure array; HIR appends trailing closures to one seven-kind argument array."},
    {"rule_id": "UCTC-R003", "text": "Message ~ is rank-15 left associative; actor :~ is rank-15 terminal and nonassociative."},
    {"rule_id": "UCTC-R004", "text": "Message calls synthesize no payload aggregate and never project one Tuple or Record payload into multiple formals."},
    {"rule_id": "UCTC-R005", "text": "A maximal trailing-closure group attaches to the immediately preceding call before static binding."},
    {"rule_id": "UCTC-R006", "text": "UnifiedCallModeAdmitted performs finite candidate-domain, structural shape, channel binding, ranking and responsibility closure before sealing one CallPlan."},
    {"rule_id": "UCTC-R007", "text": "Static call shape requires unique labels, ordered channels, Record-backed named unfold and named rest, a single rest capture and no double capture."},
    {"rule_id": "UCTC-R008", "text": "Runtime-bearing explicit arguments and trailing-closure environments evaluate once in source order before omitted defaults in formal declaration order; witnesses evaluate zero times."},
    {"rule_id": "UCTC-R009", "text": "Preparation failure invokes and publishes nothing, retains uncommitted owners and cleans the prepared prefix in reverse acquisition order exactly once."},
    {"rule_id": "UCTC-R010", "text": "Ordinary and message modes use only the closed valid mode-target pairs; actor-message uses ActorTransport only and has no ordinary fallback."},
    {"rule_id": "UCTC-R011", "text": "The ten existing HM-LR-CALL rows are the complete current CallPlan lowering table; no new HIR identity, MIR operation or runtime lookup is introduced."},
    {"rule_id": "UCTC-R012", "text": "Actor :~ performs immediate admission and never implicitly suspends, blocks or retries."},
    {"rule_id": "UCTC-R013", "text": "Actor admission rejection is a Result error on normal expression flow; one-way send creates no reply token and request creates Reply identities only after successful commit."},
    {"rule_id": "UCTC-R014", "text": "Actor transport consumes one exact preverified protocol binding and never reselects by runtime, source or import order."},
    {"rule_id": "UCTC-R015", "text": "Actor declarations require explicit top-level visibility, admit an empty body, and delegate invalid mailbox capacity rejection to actor_mailbox_capacity."},
    {"rule_id": "UCTC-R016", "text": "Formatter and LSP preserve CallMode, selector qualification, comma ownership and trailing-closure attachment without semantic rewrite."},
    {"rule_id": "UCTC-R017", "text": "This R57 candidate supplies E2 structured static evidence only; all product lanes remain NOT_RUN and GitHub publication remains suspended."}
  ],
