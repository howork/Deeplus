  "rules": [
    {
      "rule_id": "MVTC-R001",
      "text": "Member visibility surface spelling is exactly +, -, or #; member visibility keywords are not aliases."
    },
    {
      "rule_id": "MVTC-R002",
      "text": "The three sigils normalize exactly to PUBLIC, PRIVATE, and HIERARCHY_PROTECTED respectively."
    },
    {
      "rule_id": "MVTC-R003",
      "text": "An omitted member-visibility sigil remains the explicit syntax state OMITTED with null semantic value; R58 supplies no global default."
    },
    {
      "rule_id": "MVTC-R004",
      "text": "The access lattice is the strict order private - below hierarchy-protected # below public +."
    },
    {
      "rule_id": "MVTC-R005",
      "text": "Hierarchy-protected # access is admitted only for the declaring nominal type or one of its nominal subclasses."
    },
    {
      "rule_id": "MVTC-R006",
      "text": "Module peers, nominal conformers that are not subclasses, and structurally similar peers are rejected for # access with REFERENCE_VISIBILITY_OR_ACTIVATION_VIOLATION."
    },
    {
      "rule_id": "MVTC-R007",
      "text": "Conformance and structural similarity never manufacture nominal-subclass visibility authority."
    },
    {
      "rule_id": "MVTC-R008",
      "text": "An override retains the original declaring nominal slot as its visibility anchor and cannot narrow that slot's visibility."
    },
    {
      "rule_id": "MVTC-R009",
      "text": "Member visibility is closed statically and emits no runtime visibility check, runtime instruction, HIR identity, or MIR operation kind."
    },
    {
      "rule_id": "MVTC-R010",
      "text": "A rejected visibility access or declaration leaves no HIR residue."
    },
    {
      "rule_id": "MVTC-R011",
      "text": "The member-surface keyword rejection is delegated from member_visibility_sigil_surface_phase_a to member_visibility_sigils_only."
    },
    {
      "rule_id": "MVTC-R012",
      "text": "This R58 candidate is E2 structured static evidence only; product lanes remain NOT_RUN and GitHub publication remains suspended."
    }
  ],
