  "rules": [
    {"rule_id": "MECDTC-R001", "text": "Member-extension collision is a static integrated-checker judgment over distinct applicable nominal-member and active-extension sets."},
    {"rule_id": "MECDTC-R002", "text": "If either applicable set is empty, the collision predicate admits and leaves winner selection to the existing owning domain."},
    {"rule_id": "MECDTC-R003", "text": "If both applicable sets are nonempty for an ordinary selector, MEMBER_EXTENSION_COLLISION is terminal with selected_count zero."},
    {"rule_id": "MECDTC-R004", "text": "The cross-domain test precedes within-domain ranking, so no ambiguity or order rule may escape the collision."},
    {"rule_id": "MECDTC-R005", "text": "An exact qualified-extension selector restricts lookup before the cross-domain predicate and bypasses only that predicate."},
    {"rule_id": "MECDTC-R006", "text": "MEMBER_EXTENSION_COLLISION is the sole active primary and precedes any same-stage generic fallback."},
    {"rule_id": "MECDTC-R007", "text": "Retired compatibility diagnostics remain nonemitting and no new diagnostic identity is created."},
    {"rule_id": "MECDTC-R008", "text": "A rejected collision creates no selected member, selected extension, HirCallPlan, canonical HIR node, or recovery HIR."},
    {"rule_id": "MECDTC-R009", "text": "A rejected collision creates no MIR operation or terminator and no xVM, runtime-ABI, or backend residue."},
    {"rule_id": "MECDTC-R010", "text": "Runtime provider, selector, address, link, import, use, activation, source, or nesting order cannot reselect the rejected call."},
    {"rule_id": "MECDTC-R011", "text": "R71 remains the owner split for already selected calls and is not changed by this rejection-only dynamic disposition."},
    {"rule_id": "MECDTC-R012", "text": "R72 changes exactly one trace cell and leaves all adjacent feature stages and test outcomes unchanged."},
    {"rule_id": "MECDTC-R013", "text": "Semantic P0 remains zero, feature P1 remains 22 OPEN, M13 remains four OPEN actions, product lanes remain 15/15 NOT_RUN, and GitHub publication remains suspended."}
  ],
