  "rules": [
    {
      "rule_id": "IRA-R001",
      "law": "Verified Deeplus MIR remains semantic authority and the internal ABI is a target projection only."
    },
    {
      "rule_id": "IRA-R002",
      "law": "R1 compatibility requires exact ABI ID and full canonical digest equality."
    },
    {
      "rule_id": "IRA-R003",
      "law": "Only the fixed primitive scalar set is direct; aggregates and nominal values are indirect typed slots."
    },
    {
      "rule_id": "IRA-R004",
      "law": "Aggregate normal results use the caller-provided normal slot as sret and are never register-split."
    },
    {
      "rule_id": "IRA-R005",
      "law": "COMPLETE carries exactly one NORMAL ERROR DEFECT or CANCELLATION OutcomeTag and commits one selected disjoint slot."
    },
    {
      "rule_id": "IRA-R006",
      "law": "PARKED carries one ContinuationReceiptId, commits no outcome or MIR successor, and requires the separate continuation interface."
    },
    {
      "rule_id": "IRA-R007",
      "law": "Ownership commits exactly once immediately before callee entry after all preconditions close."
    },
    {
      "rule_id": "IRA-R008",
      "law": "Pre-entry failure restores the caller; post-entry outcomes never restore transferred inputs."
    },
    {
      "rule_id": "IRA-R009",
      "law": "Borrow and inout channels end on each completed outcome edge; PARKED transfers committed state exactly once and admits across suspension only NONE or STATIC_IMMUTABLE_SHARED loans."
    },
    {
      "rule_id": "IRA-R010",
      "law": "Host unwind and native exceptions cannot cross the boundary or select a Deeplus outcome."
    },
    {
      "rule_id": "IRA-R011",
      "law": "Every declared helper has one typed ID, exact dependency digests and exact signature/ownership digests in the sorted unique active allowlist."
    },
    {
      "rule_id": "IRA-R012",
      "law": "Missing duplicate unlisted or signature-mismatched helpers fail before execution."
    },
    {
      "rule_id": "IRA-R013",
      "law": "xVM Object AOT and JIT project one logical ABI without backend semantic reselection."
    },
    {
      "rule_id": "IRA-R014",
      "law": "Every target parameter and mapping is explicit; host defaults cannot fill a missing field."
    },
    {
      "rule_id": "IRA-R015",
      "law": "JIT retirement requires UNPUBLISHED and zero call, continuation and outstanding-root-receipt leases; addresses never act as identity."
    },
    {
      "rule_id": "IRA-R016",
      "law": "Managed handles require the exact managed-reference dependency digest."
    },
    {
      "rule_id": "IRA-R017",
      "law": "External FFI and arbitrary runtime-to-generated callbacks remain outside R1; only the exact R38 RESUME/CANCEL continuation dispatch profile is admitted."
    },
    {
      "rule_id": "IRA-R018",
      "law": "Static validation creates no implementation execution P1 closure or product support."
    }
  ],
