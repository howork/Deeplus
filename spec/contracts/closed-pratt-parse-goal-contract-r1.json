    "conflict": "frontend-model expression.postfix lists message at lbp 190 while language.md and mode_and_pratt_contract place ~ and :~ at rank 15",
    "decision": "rank 15 is controlling; remove message from generic postfix projection and register ~ and :~ as distinct structured led parselets",
    "semantic_reason": "assignment at 10 remains the only lower family; ternary at 20 remains the next higher family; ~ is left-associative and :~ is terminal",
    "new_surface_count": 0
  },
  "additional_conflict_resolutions": [
    {
      "id": "MEASURE_LITERAL_VS_INDEX",
      "decision": "an attached '[' immediately after one physical numeric literal token first runs the Measure structured-primary probe; after nonempty trivia, a transactional separated-measure lookahead parses UnitExpr and the closing ']' without type information, emits UNIT_LITERAL_BRACKET_MUST_BE_ATTACHED with one recovery CST node only when that lookahead succeeds, and otherwise consumes zero bracket tokens and emits zero diagnostics before ordinary IndexSuffix remains available",
      "type_information_used": false
    },
    {
      "id": "RANGE_STEP_VS_TERNARY_COLON",
      "decision": "after '..', '..<', or '...' commits RangeExpr, one following ':' belongs to the Range parselet and consumes the step expression; otherwise ':' retains its existing owner",
      "type_information_used": false
    }
  ],
