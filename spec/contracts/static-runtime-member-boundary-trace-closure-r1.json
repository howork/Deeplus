  "rules": [
    {
      "rule_id": "SRMBTC-R001",
      "text": "Only static_runtime_member_boundary_law DYNAMIC_LOWERING transitions, from APPLICABLE_BLOCKED_BY_GAP to NOT_APPLICABLE."
    },
    {
      "rule_id": "SRMBTC-R002",
      "text": "A module identity or static qualifier is resolver identity, not a runtime value, and receives no expression-HIR projection."
    },
    {
      "rule_id": "SRMBTC-R003",
      "text": "A successfully selected terminal static value or callable may project through existing ResolvedRef or CallPlan contracts after the qualifier lookup is erased."
    },
    {
      "rule_id": "SRMBTC-R004",
      "text": "Nominal type-side, named type-side extension, Trait-qualified associated static, and explicit runtime owner lookup remain four disjoint domains with zero fallback or order winner."
    },
    {
      "rule_id": "SRMBTC-R005",
      "text": "Double colon remains static qualification and dot remains runtime member access; R70 creates no companion or metatype value."
    },
    {
      "rule_id": "SRMBTC-R006",
      "text": "ModuleId has no expression-HIR projection; a selected static declaration uses ResolvedRef::DirectDecl(DeclId) with zero unresolved, candidate-set, or runtime-relookup residue."
    },
    {
      "rule_id": "SRMBTC-R007",
      "text": "Static values reuse HM-LR-REF-002 and HM-LR-TOP-002; ordinary dot field reads reuse PlacePlan FIELD plus HM-LR-TOP-006."
    },
    {
      "rule_id": "SRMBTC-R008",
      "text": "Direct, virtual, and extension-static calls reuse HM-LR-CALL-001, HM-LR-CALL-002, and HM-LR-CALL-004 with their exact existing mode-target pairs."
    },
    {
      "rule_id": "SRMBTC-R009",
      "text": "Ordinary dot place and call behavior remains owned by existing place, call, method-extension, and collision features; R70 changes none of their cells."
    },
    {
      "rule_id": "SRMBTC-R010",
      "text": "xVM consumes existing Verified Deeplus MIR operations and capabilities and performs no selector or member-name lookup."
    },
    {
      "rule_id": "SRMBTC-R011",
      "text": "The internal runtime ABI transports typed calls only and gains no module, static-path, selector, or member-name payload or helper."
    },
    {
      "rule_id": "SRMBTC-R012",
      "text": "Cranelift deterministically projects Verified Deeplus MIR to backend-private CLIF and cannot reselect semantics by symbol, link order, address, or target identity."
    },
    {
      "rule_id": "SRMBTC-R013",
      "text": "R70 preserves exact diagnostic ownership and precedence and invents no diagnostic or cross-owner primary selection."
    },
    {
      "rule_id": "SRMBTC-R014",
      "text": "Semantic P0 remains zero, feature P1 remains 22 OPEN, M13 remains four OPEN actions, product lanes remain 15/15 NOT_RUN, and GitHub publication remains suspended."
    }
  ],
