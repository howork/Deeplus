  "rules": [
    {"rule_id": "MERTC-R001", "text": "Only method_extension_resolution_policy DYNAMIC_LOWERING transitions, from APPLICABLE_BLOCKED_BY_GAP(IR-XCUT-P1-054) to BOUND_DELEGATED."},
    {"rule_id": "MERTC-R002", "text": "The method/extension feature retains all activation, lookup-domain, applicability, collision, ambiguity, and terminal-selection responsibility."},
    {"rule_id": "MERTC-R003", "text": "An ordinary selector with applicable nominal and active-extension domains is rejected with selected count zero before HIR."},
    {"rule_id": "MERTC-R004", "text": "A qualified extension selector restricts lookup to its exact extension domain but does not add runtime provider search."},
    {"rule_id": "MERTC-R005", "text": "A selected extension call preserves exactly one ExtensionSetId, ExtensionMemberId, and CallableImplementationId before MIR lowering."},
    {"rule_id": "MERTC-R006", "text": "Unresolved identities and candidate sets are forbidden in canonical HIR and no selector or provider name becomes runtime payload."},
    {"rule_id": "MERTC-R007", "text": "Ordinary extension calls use ORDINARY::EXTENSION_STATIC and HM-LR-CALL-004 exactly."},
    {"rule_id": "MERTC-R008", "text": "Message extension calls use MESSAGE::EXTENSION_STATIC and HM-LR-CALL-008 exactly."},
    {"rule_id": "MERTC-R009", "text": "Dynamic execution of a statically sealed ExtensionStatic HirCallPlan is delegated to unified_call_expression_and_tilde_modes through HM-LR-CALL-004 or HM-LR-CALL-008; method_extension_resolution_policy retains the static winner, collision, ambiguity, and identity contract."},
    {"rule_id": "MERTC-R010", "text": "Both lowering rows evaluate the receiver once and order CONTEXT_ADAPT before INVOKE."},
    {"rule_id": "MERTC-R011", "text": "The message row preserves its existing reply-correlation token while the ordinary row creates none."},
    {"rule_id": "MERTC-R012", "text": "xVM, the runtime ABI, and Cranelift perform zero extension/provider/selector relookup and cannot choose by address or link order."},
    {"rule_id": "MERTC-R013", "text": "Dynamic extension dispatch and extension-created Trait witnesses remain forbidden."},
    {"rule_id": "MERTC-R014", "text": "Boundary and reject test cells remain under their existing static owners and are not transitioned by R71."},
    {"rule_id": "MERTC-R015", "text": "Semantic P0 remains zero, feature P1 remains 22 OPEN, M13 remains four OPEN actions, product lanes remain 15/15 NOT_RUN, and GitHub publication remains suspended."}
  ],
